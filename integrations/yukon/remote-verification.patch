new file mode 100644
index 00000000..adaad5c3
--- /dev/null
+++ b/src/execution/remote-verification-contract.ts
@@ -0,0 +1,54 @@
+import { z } from "zod/v4";
+import { ParetoObjectivesSchema } from "../benchmark/pareto.ts";
+
+/** Shared by every service implementing stored verification retrieval. */
+export const REMOTE_VERIFICATION_PROTOCOL = "yukon-remote-verification-v1";
+export const REMOTE_VERIFICATION_PATH = "/yukon/v1/retrieve";
+export const REMOTE_RECEIPT_MAX_BYTES = 64 * 1024;
+
+// Service-specific evidence is opaque to Yukon. It is never a URL or credential.
+export const RemoteVerificationReferenceSchema = z.record(z.string(), z.json());
+// An operator-selected logical problem and immutable dataset/contract version.
+export const RemoteVerificationProblemSchema = z.object({
+  id: z.string().min(1).max(256),
+  version: z.string().min(1).max(256),
+}).strict();
+export const RemoteVerificationRequestSchema = z.object({
+  protocol: z.literal(REMOTE_VERIFICATION_PROTOCOL),
+  kind: z.enum(["baseline", "submission"]),
+  owner_id: z.uuid(),
+  benchmark_id: z.uuid(),
+  benchmark_revision: z.string().min(1).max(1024),
+  submission_id: z.uuid(),
+  problem: RemoteVerificationProblemSchema,
+  reference: RemoteVerificationReferenceSchema,
+  objectives: ParetoObjectivesSchema,
+  judge: z.object({
+    policies: z.object({ scoring: z.json(), validity: z.json() }).strict(),
+    fields: z.union([
+      z.object({ scores: z.literal(true), validity: z.boolean() }).strict(),
+      z.object({ scores: z.literal(false), validity: z.literal(true) }).strict(),
+    ]),
+  }).strict(),
+}).strict();
+
+export const RemoteVerificationResponseSchema = z.object({
+  protocol: z.literal(REMOTE_VERIFICATION_PROTOCOL),
+  // Echo binds the response to every requested identity, policy and field.
+  request: RemoteVerificationRequestSchema,
+  // Computed from the verified submission by the service, never a solver label.
+  artifact: z.object({
+    kind: z.string().min(1).max(64),
+    sha256: z.string().regex(/^[a-f0-9]{64}$/),
+  }).strict(),
+  // Field selection and tuple length are validated by Yukon's Pareto parser.
+  judgment: z.object({
+    scores: z.array(z.number().finite()).min(1).nullable().optional(),
+    valid: z.boolean().optional(),
+    reason: z.string().min(1).max(4000).optional(),
+    metrics: z.json().optional(),
+  }).strict(),
+}).strict();
+
+export type RemoteVerificationRequest = z.infer<typeof RemoteVerificationRequestSchema>;
+export type RemoteVerificationProblem = z.infer<typeof RemoteVerificationProblemSchema>;
