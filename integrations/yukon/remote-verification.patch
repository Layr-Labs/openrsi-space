@@ -0,0 +1,222 @@
+/** Local Yukon stack: real HTTP API, PostgreSQL, queue, worker and remote verifier.
+ * GitHub publication is replaced by a private local Git repository.
+ * This module is never imported by the hosted server.
+ */
+import { createHash } from "node:crypto";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import * as tar from "tar";
+import postgres from "postgres";
+import { createYukonApi, LocalSubmissionArchiveStorage, LocalTraceStorage } from "../api/index.ts";
+import { loadBenchmarkManifest, loadRepositoryBenchmarkManifest, selectBenchmarkManifest } from "../benchmark/manifest.ts";
+import { RemoteVerificationExecutionProvider, type RemoteVerificationServices } from "../execution/remote-verification.ts";
+import { readSubmissionArchiveFiles } from "../execution/submission.ts";
+import { pushGitSubmission } from "../integrations/git-submission.ts";
+import type { GitHubRepositoryGateway, PushSubmissionBranchInput } from "../integrations/github.ts";
+import type { MaterializeBenchmarkSourceInput, ResolveBenchmarkSourceInput } from "../source/types.ts";
+import { PostgresYukonStore } from "../store/index.ts";
+import { WorkerPoller, YukonWorker, startWorkerPollerWithRecovery } from "../worker/index.ts";
+
+const repositoryRoot = path.resolve(import.meta.dir, "../..");
+const databaseName = "yukon_catalyst_local";
+const email = "catalyst-local@example.invalid";
+const username = "catalyst-local";
+const gitEnv = { PATH: process.env.PATH, GIT_CONFIG_NOSYSTEM: "1", GIT_CONFIG_GLOBAL: "/dev/null",
+  GIT_AUTHOR_NAME: "Local Yukon test", GIT_AUTHOR_EMAIL: email,
+  GIT_COMMITTER_NAME: "Local Yukon test", GIT_COMMITTER_EMAIL: email };
+
+async function command(args: string[], cwd = repositoryRoot, env?: NodeJS.ProcessEnv): Promise<string> {
+  const child = Bun.spawn(args, { cwd, env, stdout: "pipe", stderr: "pipe" });
+  const [out, err, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]);
+  if (code !== 0) throw new Error(`${args[0]} failed (${code}): ${err}`);
+  return out.trim();
+}
+async function git(cwd: string, ...args: string[]) {
+  return command(["git", "-c", "core.hooksPath=/dev/null", "-c", "commit.gpgsign=false", ...args], cwd, gitEnv);
+}
+async function save(filename: string, value: unknown) {
+  await mkdir(path.dirname(filename), { recursive: true, mode: 0o700 });
+  await writeFile(filename, JSON.stringify(value, null, 2) + "\n", { mode: 0o600 });
+}
+async function json(filename: string) { return JSON.parse(await readFile(filename, "utf8")); }
+
+// Restrict source access to this launcher's own fixture repository, and always
+// materialize an exact Git revision. No solver source executes on the API host.
+export class LocalReceiptRepository implements GitHubRepositoryGateway {
+  readonly url: string;
+  constructor(readonly directory: string) { this.url = pathToFileURL(directory).href; }
+  private check(sourceUrl: string) {
+    if (sourceUrl !== this.url) throw new Error("Local Catalyst server accepts only its configured benchmark repository");
+  }
+  async resolve(input: ResolveBenchmarkSourceInput) {
+    this.check(input.sourceUrl);
+    const sourceRef = await git(this.directory, "rev-parse", "main");
+    const materialized = await this.materialize({ ...input, sourceRef, sourceBranch: "main" });
+    try {
+      const repositoryManifest = await loadRepositoryBenchmarkManifest(materialized.path, input.rootDir);
+      return { sourceUrl: this.url, sourceBranch: "main", sourceRef, repositoryPrivate: false,
+        repositoryManifest, manifest: selectBenchmarkManifest(repositoryManifest, { trackName: input.trackName }) };
+    } finally { await materialized.cleanup(); }
+  }
+  async materialize(input: MaterializeBenchmarkSourceInput) {
+    this.check(input.sourceUrl);
+    if (!/^[a-f0-9]{40}$/.test(input.sourceRef)) throw new Error("Exact local source commit required");
+    const temp = await mkdtemp(path.join(os.tmpdir(), "yukon-local-receipt-"));
+    const destination = path.join(temp, "repo");
+    try {
+      await mkdir(destination);
+      await git(this.directory, "archive", "--format=tar", `--output=${path.join(temp, "source.tar")}`, input.sourceRef);
+      await tar.x({ file: path.join(temp, "source.tar"), cwd: destination });
+      return { path: destination, sourceRef: input.sourceRef, cleanup: async () => { await rm(temp, { recursive: true, force: true }); } };
+    } catch (error) { await rm(temp, { recursive: true, force: true }); throw error; }
+  }
+  async createRepositoryAccessToken(): Promise<string> { throw new Error("Local Git has no access token"); }
+  async findAcceptedSubmissionCommit() { return null; }
+  async resolveGitHubUserId() { return null; }
+  async pushSubmissionBranch(input: PushSubmissionBranchInput) {
+    const source = await this.materialize({ ...input, sourceRef: input.baseRef });
+    try {
+      const manifest = await loadBenchmarkManifest(source.path, input.rootDir);
+      if (manifest.runner?.provider !== "remote-verification") throw new Error("Receipt benchmark required");
+      const files = await readSubmissionArchiveFiles(input.submissionArchivePath, manifest);
+      const commitSha = await pushGitSubmission({
+        remoteUrl: this.directory, baseRef: input.baseRef, branchName: input.branchName,
+        files, editablePaths: [manifest.runner.receiptPath], allowUnchanged: true,
+        assertChanges: async () => {},
+        publish: async treeSha => {
+          const sha = await git(this.directory, "commit-tree", treeSha, "-p", input.baseRef, "-m", input.message);
+          await git(this.directory, "update-ref", `refs/heads/${input.branchName}`, sha);
+          return sha;
+        },
+      });
+      return { commitSha, manifest };
+    } finally { await source.cleanup(); }
+  }
+}
+
+async function startDatabase(state: string): Promise<string> {
+  // A dedicated container per state directory, never a supplied or production DB.
+  const name = `yukon-catalyst-${createHash("sha256").update(state).digest("hex").slice(0, 12)}`;
+  let container;
+  try { container = JSON.parse(await command(["docker", "inspect", name]))[0]; } catch { /* create below */ }
+  if (!container) {
+    await command(["docker", "run", "-d", "--name", name, "--label", `yukon.catalyst.state=${state}`,
+      "-e", "POSTGRES_PASSWORD=yukon-local-only", "-e", `POSTGRES_DB=${databaseName}`,
+      "-p", "127.0.0.1::5432", "postgres:16-alpine"]);
+  } else {
+    if (container.Config.Labels?.["yukon.catalyst.state"] !== state) throw new Error("Database container ownership mismatch");
+    if (!container.State.Running) await command(["docker", "start", name]);
+  }
+  container = JSON.parse(await command(["docker", "inspect", name]))[0];
+  const binding = container.NetworkSettings.Ports["5432/tcp"][0];
+  if (binding.HostIp !== "127.0.0.1") throw new Error("Local database must bind only to loopback");
+  for (let attempt = 0; attempt < 60; attempt++) {
+    try { await command(["docker", "exec", name, "pg_isready", "-U", "postgres"]); break; }
+    catch { if (attempt === 59) throw new Error("Local Postgres did not become ready"); await Bun.sleep(250); }
+  }
+  await save(path.join(state, "database.json"), { container: name, port: binding.HostPort });
+  return `postgres://postgres:yukon-local-only@127.0.0.1:${binding.HostPort}/${databaseName}`;
+}
+
+export async function serveCatalystLocal(stateArg: string, workspaceArg: string, verifiersArg: string) {
+  const state = path.resolve(stateArg);
+  const workspace = path.resolve(workspaceArg);
+  process.chdir(repositoryRoot);
+  await mkdir(state, { recursive: true, mode: 0o700 });
+  const manifest = await loadBenchmarkManifest(workspace);
+  if (manifest.runner?.provider !== "remote-verification") throw new Error("Remote-verification manifest required");
+  const services: RemoteVerificationServices = await json(path.resolve(verifiersArg));
+  const owner = services[manifest.runner.service]?.baselineOwnerId;
+  if (!owner || !/^[a-f0-9-]{36}$/.test(owner)) throw new Error("Provisioned Catalyst owner UUID required");
+  const repo = path.join(state, "benchmark");
+  if (!await Bun.file(path.join(repo, ".git/HEAD")).exists()) {
+    await mkdir(path.join(repo, path.dirname(manifest.runner.receiptPath)), { recursive: true });
+    await writeFile(path.join(repo, "benchmark.json"), await readFile(path.join(workspace, "benchmark.json")));
+    await writeFile(path.join(repo, manifest.runner.receiptPath), await readFile(path.join(workspace, manifest.runner.receiptPath)));
+    await git(repo, "init", "--initial-branch=main", "--template=");
+    await git(repo, "add", "benchmark.json", manifest.runner.receiptPath);
+    await git(repo, "commit", "-m", "Local Catalyst receipt benchmark");
+  }
+  const databaseUrl = await startDatabase(state);
+  const store = PostgresYukonStore.connect(databaseUrl);
+  await store.migrate();
+  // A provisioned local account with the same owner UUID as Catalyst's receipt.
+  // This bootstrap never authenticates or modifies an account in hosted Yukon.
+  const sql = postgres(databaseUrl, { max: 1 });
+  try {
+    await sql`INSERT INTO accounts (id, email, username) VALUES (${owner}, ${email}, ${username})
+      ON CONFLICT (id) DO NOTHING`;
+  } finally { await sql.end(); }
+  const account = await store.getAccount(owner);
+  if (account?.email !== email) throw new Error("Local database account differs from configured test identity");
+  const configPath = path.join(state, "cli/yukon/config.json");
+  const previous = await Bun.file(configPath).exists() ? await json(configPath) : null;
+  const token = previous?.token ?? (await store.mintApiKey({ accountId: owner, name: "local-catalyst" })).token;
+  process.env.YUKON_BENCHMARK_IMPORTER_EMAILS = email;
+  const repositoryGateway = new LocalReceiptRepository(repo);
+  const archiveStorage = new LocalSubmissionArchiveStorage(path.join(state, "archives"));
+  const executionProvider = new RemoteVerificationExecutionProvider(repositoryGateway, services);
+  const worker = new YukonWorker({ store, repositoryGateway, archiveStorage, executionProvider });
+  const app = createYukonApi({ store, repositoryGateway, archiveStorage, executionProvider,
+    traceStorage: new LocalTraceStorage(path.join(state, "traces")) });
+  const server = Bun.serve({ hostname: "127.0.0.1", port: previous ? new URL(previous.apiBaseUrl).port : 0,
+    fetch: request => app.fetch(request) });
+  const base = `http://127.0.0.1:${server.port}`;
+  const poller = new WorkerPoller(worker, { concurrency: 1, intervalMs: 100,
+    onError: error => console.error("Local worker:", error),
+    onJobProcessed: result => console.log("Yukon worker:", result.jobId, result.status) });
+  let stopping = false;
+  const stop = async () => {
+    if (stopping) return; stopping = true;
+    poller.stop(); await server.stop(true); await store.close(); process.exit(0);
+  };
+  process.once("SIGINT", () => void stop());
+  process.once("SIGTERM", () => void stop());
+  try {
+    await save(configPath, { apiBaseUrl: base, token, accountId: owner, telemetry: false, traceCapture: false });
+    async function api(route: string, document: unknown) {
+      const response = await fetch(base + route, { method: "POST",
+        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+        body: JSON.stringify(document) });
+      if (!response.ok) throw new Error(`Local Yukon ${route}: ${response.status} ${await response.text()}`);
+      return response.json() as Promise<any>;
+    }
+    let benchmark = await store.getBenchmarkByName(`${username}/catalyst`);
+    if (!benchmark) {
+      const imported = await api("/api/benchmarks", { sourceUrl: repositoryGateway.url, sourceBranch: "main", name: `${username}/catalyst` });
+      benchmark = imported.benchmark;
+    }
+    const benchmarkId = benchmark!.id;
+    // Import assigns the ID before workers run, so operators can authorize it
+    // on both services without letting an unapproved baseline contact a verifier.
+    if (services[manifest.runner.service]?.benchmarks?.[benchmarkId]?.enabled !== true) {
+      throw new Error(`Benchmark ${benchmarkId} is queued. Enable this exact benchmark and problem version in the private Yukon verifier config and Catalyst consumer grant, then restart. No worker was started.`);
+    }
+    await startWorkerPollerWithRecovery(worker, poller);
+    for (let attempt = 0; attempt < 300; attempt++) {
+      benchmark = await store.getBenchmark(benchmarkId);
+      if (benchmark?.status === "ready" || benchmark?.status === "open") break;
+      if (benchmark?.status === "failed") throw new Error("Catalyst baseline retrieval failed; check tunnel, protocol and receipt");
+      if (attempt === 299) throw new Error("Baseline retrieval did not finish within 60 seconds");
+      await Bun.sleep(200);
+    }
+    if (benchmark?.status === "ready") await api(`/api/benchmarks/${benchmarkId}/open`, {});
+    const clientWorkspace = path.join(state, "solver");
+    await mkdir(path.join(clientWorkspace, path.dirname(manifest.runner.receiptPath)), { recursive: true });
+    await writeFile(path.join(clientWorkspace, "benchmark.json"), await readFile(path.join(repo, "benchmark.json")));
+    if (!await Bun.file(path.join(clientWorkspace, manifest.runner.receiptPath)).exists()) {
+      await writeFile(path.join(clientWorkspace, manifest.runner.receiptPath), await readFile(path.join(repo, manifest.runner.receiptPath)));
+    }
+    if (!await Bun.file(path.join(clientWorkspace, ".git/HEAD")).exists()) await git(clientWorkspace, "init", "--template=");
+    await save(path.join(state, "connection.json"), { apiBaseUrl: base, benchmarkId, workspace: clientWorkspace,
+      configDir: path.join(state, "cli"), repository: repo, receiptPath: manifest.runner.receiptPath });
+    console.log(`READY: local Yukon API and worker at ${base}`);
+    console.log(`Benchmark: ${benchmarkId}; client workspace: ${clientWorkspace}`);
+    console.log(`Submit separately: bun scripts/check-catalyst-local.ts ${state}`);
+    console.log("Ctrl+C stops API/worker. PostgreSQL retains state; container name is in database.json.");
+  } catch (error) {
+    poller.stop(); await server.stop(true); await store.close(); throw error;
+  }
+}
diff --git a/src/execution/remote-verification.ts b/src/execution/remote-verification.ts
new file mode 100644
index 00000000..ff250dc6
--- /dev/null
+++ b/src/execution/remote-verification.ts
@@ -0,0 +1,189 @@
+import { readFile, lstat } from "node:fs/promises";
+import { readFileSync } from "node:fs";
+import { loadBenchmarkManifest, type BenchmarkManifest } from "../benchmark/manifest.ts";
+import { joinRootDir, resolveRepoPath } from "../benchmark/paths.ts";
+import { paretoJudgeInput } from "../benchmark/pareto.ts";
+import { parseBenchmarkScore, sanitizeScoreForOutput } from "../benchmark/score.ts";
+import type { BenchmarkSourceMaterializer } from "../source/types.ts";
+import { readSubmissionArchiveFiles, manifestWithMaxSubmissionBytes, materializeSubmissionArchive,
+  submissionArchiveLimitsForManifest } from "./submission.ts";
+import type { BaselineRunResult, BenchmarkRunInput, BenchmarkRunResult, ExecutionProvider,
+  RecoverSubmissionValidationInput, SubmissionPromotionInput, SubmissionPromotionResult,
+  SubmissionValidationInput, SubmissionValidationResult } from "./types.ts";
+import { REMOTE_VERIFICATION_PROTOCOL, REMOTE_VERIFICATION_PATH, REMOTE_RECEIPT_MAX_BYTES,
+  RemoteVerificationReferenceSchema, RemoteVerificationRequestSchema,
+  RemoteVerificationResponseSchema, RemoteVerificationProblemSchema,
+  type RemoteVerificationProblem } from "./remote-verification-contract.ts";
+
+const UUID = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/;
+type Service = { url: string; token: string; baselineOwnerId: string;
+  benchmarks: Record<string, { enabled: boolean; problem: RemoteVerificationProblem }> };
+export type RemoteVerificationServices = Record<string, Service>;
+
+/** The deployment selects destinations and credentials. A manifest only names a service. */
+export class RemoteVerificationExecutionProvider implements ExecutionProvider {
+  constructor(private readonly materializer: BenchmarkSourceMaterializer,
+    private readonly services: RemoteVerificationServices) {}
+
+  static fromEnv(materializer: BenchmarkSourceMaterializer): RemoteVerificationExecutionProvider {
+    const filename = process.env.YUKON_REMOTE_VERIFIERS_FILE;
+    return new RemoteVerificationExecutionProvider(materializer,
+      filename ? JSON.parse(readFileSync(filename, "utf8")) as RemoteVerificationServices : {});
+  }
+
+  async runBaseline(input: BenchmarkRunInput): Promise<BaselineRunResult> {
+    const result = await this.retrieve(input);
+    return result.ok ? { ...result, setupSnapshotRef: `remote-verification:${input.source.sourceRef}` } : result;
+  }
+
+  async validateSubmission(input: SubmissionValidationInput): Promise<SubmissionValidationResult> {
+    const result = await this.retrieve(input, input);
+    const shared = { currentBestScore: input.currentBestScore, improved: false as const,
+      newBestScore: input.currentBestScore };
+    return result.ok ? { ...result, ...shared, submissionApplied: true }
+      : { ...result, ...shared, submissionApplied: false };
+  }
+
+  // Repeating preparation is safe: this provider can only retrieve, never enqueue execution.
+  async recoverSubmissionValidation(_input: RecoverSubmissionValidationInput) {
+    return { retryPreparation: true as const };
+  }
+
+  async publishAcceptedSubmission(_input: SubmissionPromotionInput): Promise<SubmissionPromotionResult> {
+    return { ok: false, commands: [], error: { code: "not_implemented",
+      message: "Remote verification uses Pareto evidence; source promotion requires a separate reviewed action." } };
+  }
+
+  private async retrieve(input: BenchmarkRunInput, submission?: SubmissionValidationInput): Promise<BenchmarkRunResult> {
+    let manifest: BenchmarkManifest | undefined;
+    let cleanupSource: (() => Promise<void>) | undefined;
+    let cleanupArchive: (() => Promise<void>) | undefined;
+    try {
+      submission?.signal?.throwIfAborted();
+      const materialized = await this.materializer.materialize(input.source);
+      cleanupSource = () => materialized.cleanup();
+      if (materialized.sourceRef !== input.source.sourceRef) throw new Error("Source revision mismatch.");
+      manifest = manifestWithMaxSubmissionBytes(
+        await loadBenchmarkManifest(materialized.path, input.rootDir, { trackName: input.source.trackName }),
+        submission?.maxSubmissionBytes);
+      const runner = manifest.runner;
+      if (manifest.mode !== "pareto" || manifest.promotionMode !== "manual"
+        || runner?.provider !== "remote-verification"
+        || (input.runner && stable(input.runner) !== stable(runner))) throw new Error("Remote verification requires a pinned manual Pareto manifest.");
+      const service = this.services[runner.service];
+      if (!service) throw new Error("Remote verification service is not configured.");
+      // A manifest is not permission to contact a verifier. Only operator
+      // configuration may enable a service for this exact stored benchmark.
+      const authorization = input.benchmarkId ? service.benchmarks?.[input.benchmarkId] : undefined;
+      if (authorization?.enabled !== true) throw new Error("Remote verification is not enabled for this benchmark.");
+      const problem = RemoteVerificationProblemSchema.parse(authorization.problem);
+      const base = trustedEndpoint(service);
+      let reference: Record<string, unknown>;
+      if (submission) {
+        const archive = await materializeSubmissionArchive(submission.submission.url);
+        if (archive instanceof Error) throw new Error("Cannot read submission archive.");
+        cleanupArchive = () => archive.cleanup();
+        const files = await readSubmissionArchiveFiles(archive.path, manifest, submissionArchiveLimitsForManifest(manifest));
+        if (files.length !== 1 || files[0]!.repoPath !== runner.receiptPath) {
+          throw new Error("A completed remote verification receipt is the only accepted submission file.");
+        }
+        reference = parseReference(files[0]!.content.toString("utf8"));
+      } else {
+        reference = await jsonFile(resolveRepoPath(materialized.path, joinRootDir(input.rootDir, runner.receiptPath)));
+      }
+      submission?.signal?.throwIfAborted();
+      const owner = submission ? submission.solverAccountId : service.baselineOwnerId;
+      // Baselines have no solver submission record. Use the immutable benchmark
+      // identity instead of interpreting a service-specific receipt identifier.
+      const submissionId = submission ? submission.submissionId : input.benchmarkId;
+      if (!owner || !UUID.test(owner) || !input.benchmarkId || !UUID.test(input.benchmarkId)
+        || !submissionId || !UUID.test(submissionId)) throw new Error("Stored owner, benchmark and submission IDs are required.");
+      const judge = input.pareto ?? paretoJudgeInput(manifest);
+      if (!judge || stable(judge.policies) !== stable(manifest.paretoPolicies)
+        || (!judge.fields.scores && !judge.fields.validity)) throw new Error("Evaluation policies or fields differ from the pinned manifest.");
+      const request = RemoteVerificationRequestSchema.parse({
+        protocol: REMOTE_VERIFICATION_PROTOCOL, kind: submission ? "submission" : "baseline",
+        owner_id: owner, benchmark_id: input.benchmarkId, benchmark_revision: input.source.sourceRef,
+        submission_id: submissionId, problem, reference, objectives: manifest.objectives, judge,
+      });
+      if (submission?.cancellationCheck && await submission.cancellationCheck()) throw new Error("Submission cancelled.");
+      const signal = submission?.signal
+        ? AbortSignal.any([submission.signal, AbortSignal.timeout(30_000)]) : AbortSignal.timeout(30_000);
+      const response = await fetch(`${base}${REMOTE_VERIFICATION_PATH}`, {
+        method: "POST", redirect: "error", signal,
+        headers: { Authorization: `Bearer ${service.token}`, "Content-Type": "application/json" },
+        body: JSON.stringify(request),
+      });
+      if (response.status !== 200) {
+        await response.body?.cancel();
+        throw new Error(`Remote verification returned HTTP ${response.status}.`);
+      }
+      const result = RemoteVerificationResponseSchema.parse(await boundedJson(response));
+      if (stable(result.request) !== stable(request)) throw new Error("Remote verification result identity mismatch.");
+      const suppliedMetrics = result.judgment.metrics;
+      const metrics = suppliedMetrics && typeof suppliedMetrics === "object" && !Array.isArray(suppliedMetrics)
+        ? suppliedMetrics : { serviceMetrics: suppliedMetrics ?? null };
+      // Always retain the authoritative artifact/problem binding with the score.
+      // Keep public service metrics, but reserve this namespace for checked data.
+      const score = sanitizeScoreForOutput(parseBenchmarkScore({ ...result.judgment, metrics: {
+        ...metrics, remoteVerification: { service: runner.service, problem, artifact: result.artifact },
+      } }, manifest, judge.fields));
+      return { ok: true, manifest, score: score.score, judgment: score.judgment,
+        scoreMetrics: score.metrics, scoreRaw: score.raw, commands: [] };
+    } catch (error) {
+      // Network exceptions can include request details. Never log headers or server bodies.
+      const message = error instanceof Error && /^(Remote verification|A completed|Stored owner|Source revision|Submission path|Submission cancelled|Evaluation policies|Cannot read)/.test(error.message)
+        ? error.message : "Remote verification failed; check service configuration and submitted evidence.";
+      return { ok: false, ...(manifest ? { manifest } : {}), commands: [],
+        error: { code: "submission_rejected", message } };
+    } finally {
+      await cleanupArchive?.();
+      await cleanupSource?.();
+    }
+  }
+}
+
+function trustedEndpoint(service: Service): string {
+  const url = new URL(service.url);
+  if (url.username || url.password || url.search || url.hash
+    || (url.protocol !== "https:" && !(url.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)))
+    || typeof service.token !== "string" || !service.token || /[\r\n]/.test(service.token)) {
+    throw new Error("Remote verification requires HTTPS or an authenticated local tunnel.");
+  }
+  return url.toString().replace(/\/$/, "");
+}
+
+async function jsonFile(filename: string): Promise<Record<string, unknown>> {
+  const info = await lstat(filename);
+  if (!info.isFile() || info.isSymbolicLink() || info.size > REMOTE_RECEIPT_MAX_BYTES) throw new Error("Invalid reference file.");
+  return parseReference(await readFile(filename, "utf8"));
+}
+
+function parseReference(content: string): Record<string, unknown> {
+  if (Buffer.byteLength(content) > REMOTE_RECEIPT_MAX_BYTES) throw new Error("Invalid reference file.");
+  return RemoteVerificationReferenceSchema.parse(JSON.parse(content));
+}
+
+function stable(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(stable).join(",")}]`;
+  if (value && typeof value === "object") return `{${Object.keys(value).sort().map(key =>
+    `${JSON.stringify(key)}:${stable((value as Record<string, unknown>)[key])}`).join(",")}}`;
+  return JSON.stringify(value);
+}
+
+async function boundedJson(response: Response): Promise<Record<string, unknown>> {
+  const reader = response.body?.getReader();
+  if (!reader) throw new Error("Empty remote response.");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const item = await reader.read();
+      if (item.done) break;
+      size += item.value.byteLength;
+      if (size > 4 * 1024 * 1024) throw new Error("Remote response exceeds limits.");
+      chunks.push(item.value);
+    }
+  } finally { await reader.cancel(); }
+  return JSON.parse(Buffer.concat(chunks).toString("utf8")) as Record<string, unknown>;
+}
