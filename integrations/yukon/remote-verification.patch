+#!/usr/bin/env bun
+// Runs the actual CLI upload, then reads the result from Yukon's API.
+// Requires the separately started local API/worker; never runs the harness.
+import path from "node:path";
+import { readFile, writeFile } from "node:fs/promises";
+
+const [stateArg] = process.argv.slice(2);
+if (!stateArg) throw new Error("Usage: bun scripts/check-catalyst-local.ts STATE_DIRECTORY");
+const state = path.resolve(stateArg);
+const connection = JSON.parse(await readFile(path.join(state, "connection.json"), "utf8"));
+const base = new URL(connection.apiBaseUrl);
+if (base.protocol !== "http:" || base.hostname !== "127.0.0.1") throw new Error("This check only targets the local Yukon API");
+const repo = path.resolve(import.meta.dir, "..");
+const note = await readFile(path.join(repo, "docs/catalyst-receipt-local.md"), "utf8");
+const notePath = path.join(state, "local-test-note.md");
+await writeFile(notePath, note, { mode: 0o600 });
+// Explicitly isolated login and endpoint: never inherit hosted Yukon credentials.
+const environment = { PATH: process.env.PATH, HOME: process.env.HOME, TMPDIR: process.env.TMPDIR,
+  YUKON_CONFIG_DIR: connection.configDir, YUKON_API_URL: base.href };
+const cli = path.join(repo, "apps/cli/src/yukon.ts");
+const child = Bun.spawn([process.execPath, cli, "submit", connection.benchmarkId,
+  "--model", "disabled (baseline receipt)", "--harness", "ecdsa-baseline",
+  "--note-file", notePath, "--json"], { cwd: connection.workspace, env: environment, stdout: "pipe", stderr: "pipe" });
+const [out, err, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]);
+if (code !== 0) throw new Error(`Yukon CLI submission failed: ${err || out}`);
+const submitted = JSON.parse(out);
+const id = submitted.submission.id;
+let submission;
+for (let attempt = 0; attempt < 300; attempt++) {
+  const response = await fetch(new URL(`/api/submissions/${id}`, base));
+  if (!response.ok) throw new Error(`Yukon result read returned ${response.status}`);
+  submission = (await response.json() as any).submission;
+  if (submission?.evaluation?.scores?.values) break;
+  if (["failed", "rejected", "cancelled"].includes(submission?.status)) throw new Error(JSON.stringify(submission));
+  if (attempt === 299) throw new Error("Yukon worker did not record scores within 60 seconds");
+  await Bun.sleep(200);
+}
+if (!submission?.evaluation?.validity?.valid) throw new Error("Expected a valid completed baseline receipt");
+const result = { localYukonApi: connection.apiBaseUrl, benchmarkId: connection.benchmarkId,
+  submissionId: id, jobId: submitted.job?.id ?? null, deduplicated: submitted.job === null,
+  scores: submission.evaluation.scores.values, valid: submission.evaluation.validity.valid,
+  evidence: submission.evaluation.scores.evidence, resultSource: "Yukon HTTP API backed by PostgreSQL",
+  submittedFiles: [connection.receiptPath] };
+await writeFile(path.join(state, "last-result.json"), JSON.stringify(result, null, 2) + "\n", { mode: 0o600 });
+console.log(JSON.stringify(result, null, 2));
