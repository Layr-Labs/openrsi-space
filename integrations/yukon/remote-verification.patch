+import { afterEach, beforeEach, expect, test } from "bun:test";
+import { mkdir, mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import * as tar from "tar";
+import { createSubmissionArchiveForTest } from "../../apps/cli/src/core/cli.ts";
+import { parseBenchmarkManifest } from "../../src/benchmark/manifest.ts";
+import { applySubmissionToWorkspace, editablePathsToClear, readSubmissionArchiveFiles } from "../../src/execution/submission.ts";
+
+const receiptPath = "submission/verification.json";
+const manifest = parseBenchmarkManifest({
+  schemaVersion: 1, name: "catalyst", description: "Receipt submission", category: "research",
+  mode: "pareto", promotionMode: "manual",
+  objectives: [{ name: "performance", direction: "-" }, { name: "credits", direction: "-" }],
+  editablePaths: ["submission"], setupCommand: ["true"], benchmarkCommand: ["true"], scorePath: "score.json",
+  runner: { provider: "remote-verification", service: "catalyst", receiptPath },
+});
+const receipt = '{"schema_version":2,"evaluation_id":"33333333-3333-4333-8333-333333333333","evidence_mode":"remote"}';
+let root: string;
+const archives: string[] = [];
+
+beforeEach(async () => {
+  root = await mkdtemp(path.join(os.tmpdir(), "yukon-receipt-cli-"));
+  await mkdir(path.join(root, "submission"));
+  await writeFile(path.join(root, receiptPath), receipt);
+  await writeFile(path.join(root, "submission/agent.py"), "modified local harness");
+  await writeFile(path.join(root, "submission/evaluation.json"), '{"max_model_credits":200}');
+  await writeFile(path.join(root, "submission/.env"), "PRIVATE_FIXTURE_VALUE");
+});
+afterEach(async () => {
+  await Promise.all([root, ...archives.splice(0)].map(directory => rm(directory, { recursive: true, force: true })));
+});
+
+test("actual CLI upload carries only the receipt even when harness, settings and secrets exist", async () => {
+  const archive = await createSubmissionArchiveForTest(root, manifest);
+  archives.push(archive.tempDir);
+  const entries: string[] = [];
+  await tar.t({ file: archive.path, onReadEntry: entry => { entries.push(entry.path); } });
+  expect(entries).toEqual([receiptPath]);
+  const files = await readSubmissionArchiveFiles(archive.path, manifest);
+  expect(files.map(file => file.repoPath)).toEqual([receiptPath]);
+  expect(files[0]!.content.toString()).toBe(receipt);
+});
+
+test("receipt commits and workspace application preserve the existing harness and settings", async () => {
+  const archive = await createSubmissionArchiveForTest(root, manifest);
+  archives.push(archive.tempDir);
+  const destination = path.join(root, "destination");
+  await mkdir(path.join(destination, "submission"), { recursive: true });
+  await writeFile(path.join(destination, "submission/agent.py"), "benchmark starter harness");
+  await writeFile(path.join(destination, "submission/evaluation.json"), "{}");
+  await writeFile(path.join(destination, receiptPath), "old receipt");
+  expect(editablePathsToClear(manifest, [receiptPath])).toEqual([receiptPath]);
+  await applySubmissionToWorkspace({ submission: archive, workspacePath: destination, manifest });
+  expect(await readFile(path.join(destination, "submission/agent.py"), "utf8")).toBe("benchmark starter harness");
+  expect(await readFile(path.join(destination, "submission/evaluation.json"), "utf8")).toBe("{}");
+  expect(await readFile(path.join(destination, receiptPath), "utf8")).toBe(receipt);
+});
+
+test("submission needs no harness or evaluation settings and never falls back to uploading them", async () => {
+  await rm(path.join(root, "submission/agent.py"));
+  await rm(path.join(root, "submission/evaluation.json"));
+  const archive = await createSubmissionArchiveForTest(root, manifest);
+  archives.push(archive.tempDir);
+  expect((await readSubmissionArchiveFiles(archive.path, manifest)).length).toBe(1);
+  await rm(path.join(root, receiptPath));
+  await expect(createSubmissionArchiveForTest(root, manifest)).rejects.toThrow("verification receipt is missing");
+});
+
+test("rejects oversized receipts, directories and symlinked receipts or parents", async () => {
+  await writeFile(path.join(root, receiptPath), "x".repeat(65537));
+  await expect(createSubmissionArchiveForTest(root, manifest)).rejects.toThrow("regular JSON file");
+  await rm(path.join(root, receiptPath));
+  await mkdir(path.join(root, receiptPath));
+  await expect(createSubmissionArchiveForTest(root, manifest)).rejects.toThrow("regular JSON file");
+  await rm(path.join(root, receiptPath), { recursive: true });
+  await symlink(".env", path.join(root, receiptPath));
+  await expect(createSubmissionArchiveForTest(root, manifest)).rejects.toThrow("regular JSON file");
+  await rm(path.join(root, "submission"), { recursive: true });
+  await mkdir(path.join(root, "private"));
+  await writeFile(path.join(root, "private/verification.json"), receipt);
+  await symlink("private", path.join(root, "submission"));
+  await expect(createSubmissionArchiveForTest(root, manifest)).rejects.toThrow("regular JSON file");
+});
