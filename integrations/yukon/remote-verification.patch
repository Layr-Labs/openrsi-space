+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { cp, mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import * as tar from "tar";
+import { z } from "zod/v4";
+import { RemoteVerificationExecutionProvider } from "../../src/execution/remote-verification.ts";
+import { RemoteVerificationRequestSchema, RemoteVerificationResponseSchema } from "../../src/execution/remote-verification-contract.ts";
+import { parseBenchmarkManifest } from "../../src/benchmark/manifest.ts";
+import type { BenchmarkSourceMaterializer } from "../../src/source/types.ts";
+import type { SubmissionValidationInput } from "../../src/execution/types.ts";
+
+const OWNER = "11111111-1111-4111-8111-111111111111";
+const BENCHMARK = "22222222-2222-4222-8222-222222222222";
+const SUBMISSION = "44444444-4444-4444-8444-444444444444";
+const problem = { id: "compression", version: "dataset-sha256:1234" };
+const benchmarks = { [BENCHMARK]: { enabled: true, problem } };
+const runner = { provider: "remote-verification" as const, service: "lab", receiptPath: "submission/verification.json" };
+const manifest = { schemaVersion: 1, name: "compression-lab", description: "Stored compression results", category: "research",
+  mode: "pareto", promotionMode: "manual",
+  objectives: [{ name: "performance", direction: "-" }, { name: "credits", direction: "-" }],
+  paretoPolicies: { scoring: { version: "scoring" }, validity: { version: "validity" } },
+  editablePaths: ["submission"], setupCommand: ["touch", "MUST_NOT_RUN_SETUP"],
+  benchmarkCommand: ["touch", "MUST_NOT_RUN_BENCHMARK"], scorePath: "score.json", runner };
+// A non-Catalyst receipt with no evaluation UUID, schema_version or evidence_mode.
+const reference = { experiment: "compression/run:17", artifact: { revision: "sha256:abc" } };
+
+test("published JSON Schema matches the shared runtime contract", async () => {
+  const schema = await Bun.file(new URL("../../docs/remote-verification-v1.schema.json", import.meta.url)).json();
+  expect(schema).toEqual({
+    ...z.toJSONSchema(z.union([RemoteVerificationRequestSchema, RemoteVerificationResponseSchema])),
+    title: "Yukon remote verification v1",
+  });
+});
+
+describe("stored remote verification provider", () => {
+  let root: string;
+  let server: ReturnType<typeof Bun.serve>;
+  let calls: Array<Record<string, any>>;
+  let responseTransform: (value: any) => any;
+  let status: number;
+  let provider: RemoteVerificationExecutionProvider;
+  let input: SubmissionValidationInput;
+  let materializer: BenchmarkSourceMaterializer;
+  beforeEach(async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), "yukon-remote-test-"));
+    calls = [];
+    responseTransform = value => value;
+    status = 200;
+    const template = path.join(root, "template");
+    const archiveSource = path.join(root, "archive-source");
+    await mkdir(path.join(template, "submission"), { recursive: true });
+    await mkdir(path.join(archiveSource, "submission"), { recursive: true });
+    await writeFile(path.join(template, "benchmark.json"), JSON.stringify(manifest));
+    for (const base of [template, archiveSource]) {
+      await writeFile(path.join(base, "submission/verification.json"), JSON.stringify(reference));
+      await writeFile(path.join(base, "submission/evaluation.json"), '{"max_model_credits":20}');
+      await writeFile(path.join(base, "submission/agent.py"), 'raise Exception("must not execute")\n');
+    }
+    const archive = path.join(root, "submission.tgz");
+    await tar.c({ file: archive, gzip: true, cwd: archiveSource }, [runner.receiptPath]);
+    let counter = 0;
+    materializer = { async materialize(source) {
+      const folder = path.join(root, `workspace-${counter++}`);
+      await cp(template, folder, { recursive: true });
+      return { path: folder, sourceRef: source.sourceRef, async cleanup() {
+        // Commands were never executed, even though they are present in the manifest.
+        expect(await Bun.file(path.join(folder, "MUST_NOT_RUN_SETUP")).exists()).toBe(false);
+        expect(await Bun.file(path.join(folder, "MUST_NOT_RUN_BENCHMARK")).exists()).toBe(false);
+        await rm(folder, { recursive: true, force: true });
+      } };
+    } };
+    server = Bun.serve({ hostname: "127.0.0.1", port: 0, async fetch(request) {
+      expect(request.method).toBe("POST");
+      expect(new URL(request.url).pathname).toBe("/yukon/v1/retrieve");
+      expect(request.headers.get("Authorization")).toBe("Bearer consumer-test-key");
+      const body = await request.json() as Record<string, any>;
+      calls.push(body);
+      return Response.json(responseTransform({ protocol: "yukon-remote-verification-v1", request: body,
+        artifact: { kind: "solution-source", sha256: "b".repeat(64) },
+        judgment: { scores: [120, 4], valid: true, reason: "Verified", metrics: { experiment: "compression/run:17" } },
+      }), { status });
+    } });
+    provider = new RemoteVerificationExecutionProvider(materializer, { lab: {
+      url: `http://127.0.0.1:${server.port}`, token: "consumer-test-key", baselineOwnerId: OWNER,
+      benchmarks,
+    } });
+    input = { source: { sourceUrl: "https://github.com/example/compression-lab", sourceRef: "a".repeat(40), sourceBranch: "main" },
+      submission: { url: pathToFileURL(archive).href }, solverAccountId: OWNER,
+      benchmarkId: BENCHMARK, submissionId: SUBMISSION, runner, currentBestScore: null };
+  });
+  afterEach(async () => { server.stop(true); await rm(root, { recursive: true, force: true }); });
+
+  test("fetches the verified Pareto tuple; retries do not run setup or benchmark commands", async () => {
+    const first = await provider.validateSubmission(input);
+    const retry = await provider.validateSubmission(input);
+    expect(first.ok).toBe(true);
+    expect(retry.ok).toBe(true);
+    if (!first.ok) throw new Error("expected successful retrieval");
+    expect(first.judgment?.scores).toEqual([120, 4]);
+    expect(first.scoreMetrics).toMatchObject({ remoteVerification: {
+      service: "lab", problem, artifact: { kind: "solution-source", sha256: "b".repeat(64) },
+    } });
+    expect(first.commands).toEqual([]);
+    expect(first.improved).toBe(false);
+    expect(calls.length).toBe(2);
+    expect(calls[0]).toEqual(calls[1]);
+    expect(calls[0]?.owner_id).toBe(OWNER);
+    expect(Object.keys(calls[0]!).sort()).toEqual(
+      ["protocol", "kind", "owner_id", "benchmark_id", "benchmark_revision", "submission_id", "problem", "reference", "objectives", "judge"].sort());
+    expect(calls[0]?.reference).toEqual(reference);
+    expect(calls[0]?.problem).toEqual(problem);
+    expect(calls[0]?.objectives).toEqual(manifest.objectives);
+    expect(calls[0]?.benchmark_revision).toBe(input.source.sourceRef);
+    expect(JSON.stringify(first)).not.toContain("consumer-test-key");
+  });
+
+  test("baseline import retrieves existing evidence with a reusable snapshot reference", async () => {
+    const result = await provider.runBaseline(input);
+    expect(result.ok).toBe(true);
+    if (result.ok) expect(result.setupSnapshotRef).toStartWith("remote-verification:");
+    expect(calls[0]?.kind).toBe("baseline");
+    expect(calls[0]?.owner_id).toBe(OWNER);
+    expect(calls[0]?.submission_id).toBe(BENCHMARK);
+  });
+
+  test("retrieves with only a receipt, independent of local harness or evaluation settings", async () => {
+    await rm(path.join(root, "template/submission"), { recursive: true });
+    await rm(path.join(root, "archive-source"), { recursive: true });
+    // The archive contains the receipt; neither the uploaded harness nor a
+    // baseline receipt is needed to resolve a solver's completed evaluation.
+    expect((await provider.validateSubmission(input)).ok).toBe(true);
+    expect(calls[0]?.reference).toEqual(reference);
+  });
+
+  test("rejects source, settings, secrets, extra files and oversized receipts before retrieval", async () => {
+    const source = path.join(root, "archive-source");
+    const archive = path.join(root, "bad.tgz");
+    await writeFile(path.join(source, "submission/.env"), "PRIVATE_TEST_VALUE");
+    for (const entries of [
+      ["submission/agent.py"], ["submission/evaluation.json"], ["submission/.env"],
+      [runner.receiptPath, "submission/agent.py"],
+    ]) {
+      await tar.c({ file: archive, gzip: true, cwd: source }, entries);
+      expect((await provider.validateSubmission({ ...input, submission: { url: pathToFileURL(archive).href } })).ok).toBe(false);
+    }
+    await writeFile(path.join(source, runner.receiptPath), " ".repeat(65537));
+    await tar.c({ file: archive, gzip: true, cwd: source }, [runner.receiptPath]);
+    expect((await provider.validateSubmission({ ...input, submission: { url: pathToFileURL(archive).href } })).ok).toBe(false);
+    expect(calls).toEqual([]);
+  });
+
+  test("partial Pareto passes respect requested fields", async () => {
+    const result = await provider.validateSubmission({ ...input, pareto: {
+      policies: manifest.paretoPolicies, fields: { scores: false, validity: true },
+    } });
+    expect(result.ok).toBe(true);
+    if (result.ok) {
+      expect(result.judgment?.valid).toBe(true);
+      expect(result.judgment).not.toHaveProperty("scores");
+    }
+  });
+
+  test("rejects missing trusted owners, unconfigured services and HTTP destinations", async () => {
+    expect((await provider.validateSubmission({ ...input, solverAccountId: null })).ok).toBe(false);
+    expect((await new RemoteVerificationExecutionProvider(materializer, {}).validateSubmission(input)).ok).toBe(false);
+    const unsafe = new RemoteVerificationExecutionProvider(materializer, { lab: {
+      url: "http://untrusted.invalid", token: "consumer-test-key", baselineOwnerId: OWNER,
+      benchmarks,
+    } });
+    expect((await unsafe.validateSubmission(input)).ok).toBe(false);
+    expect(calls).toEqual([]);
+  });
+
+  test("fails closed on service rejection, wrong identity, missing scores and redirected responses", async () => {
+    status = 403;
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+    status = 200;
+    for (const [key, value] of Object.entries({
+      owner_id: SUBMISSION, submission_id: OWNER, benchmark_id: OWNER, kind: "baseline",
+      benchmark_revision: "other", reference: { other: "receipt" },
+      objectives: [...manifest.objectives].reverse(), judge: { fields: { scores: false, validity: true }, policies: manifest.paretoPolicies },
+      problem: { ...problem, version: "different-dataset" },
+    })) {
+      responseTransform = result => ({ ...result, request: { ...result.request, [key]: value } });
+      expect((await provider.validateSubmission(input)).ok).toBe(false);
+    }
+    responseTransform = value => ({ ...value, judgment: { valid: true, scores: [1, null] } });
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+    responseTransform = value => ({ ...value, protocol: "catalyst-yukon-v2" });
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+    responseTransform = value => ({ ...value, artifact: undefined });
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+    responseTransform = value => ({ ...value, artifact: { kind: "solution", sha256: "solver-label" } });
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+    responseTransform = value => value;
+    status = 202;
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+    status = 302;
+    expect((await provider.validateSubmission(input)).ok).toBe(false);
+  });
+
+  test("another project needs only service configuration and an opaque receipt", async () => {
+    const otherRunner = { ...runner, service: "robotics" };
+    const otherManifest = { ...manifest, runner: otherRunner,
+      objectives: [{ name: "successRate", direction: "+" }, { name: "energy", direction: "-" }] };
+    await writeFile(path.join(root, "template/benchmark.json"), JSON.stringify(otherManifest));
+    const otherReference = { report: "robotics/2026/42", url: "https://untrusted.invalid/must-not-fetch" };
+    await writeFile(path.join(root, "archive-source", runner.receiptPath), JSON.stringify(otherReference));
+    const archive = path.join(root, "robotics.tgz");
+    await tar.c({ file: archive, gzip: true, cwd: path.join(root, "archive-source") }, [runner.receiptPath]);
+    const other = new RemoteVerificationExecutionProvider(materializer, { robotics: {
+      url: `http://127.0.0.1:${server.port}`, token: "consumer-test-key", baselineOwnerId: OWNER,
+      benchmarks: { [BENCHMARK]: { enabled: true, problem: { id: "robotics", version: "mission-v4" } } },
+    } });
+    const result = await other.validateSubmission({ ...input, runner: otherRunner,
+      submission: { url: pathToFileURL(archive).href } });
+    expect(result.ok).toBe(true);
+    expect(calls[0]?.reference).toEqual(otherReference);
