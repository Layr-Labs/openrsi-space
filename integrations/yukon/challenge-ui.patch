+import { expect, test } from "bun:test";
+import { SUBMISSIONS } from "./test-fixtures";
+import { curve, onFrontier, resultAt, resultsAt } from "./metrics";
+
+test("Pareto results do not need promotion or a scalar score", () => {
+  expect(resultsAt(SUBMISSIONS, "best").map((row) => row.submission.id)).toEqual(["verified-grace", "verified-ada"]);
+  expect(resultsAt(SUBMISSIONS, "best").every((row) => onFrontier(row, resultsAt(SUBMISSIONS, "best")))).toBe(true);
+});
+test("budget views use observations at or below the limit", () => {
+  expect(resultAt(SUBMISSIONS[1], 20)?.performance).toBe(10_600_000_000);
+  expect(resultAt(SUBMISSIONS[0], 20)?.credits).toBe(0.887796);
+  expect(resultsAt(SUBMISSIONS, 200).map((row) => row.submission.id)).toEqual(["verified-grace", "verified-ada"]);
+  expect(curve(SUBMISSIONS[1])).toHaveLength(2);
+});
+test("invalid and incomplete results cannot appear", () => {
+  expect(resultAt(SUBMISSIONS[2], "best")).toBeNull();
+  for (const scores of [null, [], [1], [1, Number.NaN], [1, -1], [0, 1]]) {
+    expect(resultAt({ ...SUBMISSIONS[0], judgment: { valid: true, scores } }, "best")).toBeNull();
+  }
+});
+test("tier eligibility flags do not hide a cheaper run or override its curve", () => {
+  expect(resultAt(SUBMISSIONS[0], 200)?.performance).toBe(10_704_574_395);
+  const submission = {
+    ...SUBMISSIONS[1],
+    officialMetrics: {
+      observations: [
+        {
+          problem_id: "ecdsa.fail",
+          tiers: [{ budget_tier: 20, status: "eligible", best: { performance: 1, normalized_model_usd: 1 } }],
+        },
+      ],
+    },
+  };
+  expect(resultAt(submission, 20)).toBeNull();
+  expect(resultAt(submission, 200)?.performance).toBe(10_000_000_000);
+});
+test("inclusive boundaries, regressions and early bests retain the complete history", () => {
+  const values = [
+    { performance: 100, normalized_model_usd: 20 },
+    { performance: 110, normalized_model_usd: 20 },
+    { performance: 80, normalized_model_usd: 20.01 },
+    { performance: 70, normalized_model_usd: 200 },
+    { performance: 60, normalized_model_usd: 200.01 },
+    { performance: 90, normalized_model_usd: 300 },
+  ];
+  const submission = {
+    ...SUBMISSIONS[0],
+    judgment: { valid: true as const, scores: [60, 200.01] },
+    officialMetrics: { observations: [{ problem_id: "ecdsa.fail", curve: values }] },
+  };
+  expect(resultAt(submission, 20)?.performance).toBe(100);
+  expect(resultAt(submission, 200)?.performance).toBe(70);
+  expect(resultAt(submission, "best")?.performance).toBe(60);
+  expect(curve(submission)).toHaveLength(6);
+});
+test("human rejection overrides a valid legacy judgment", () => {
+  const submission = { ...SUBMISSIONS[0], status: "rejected" as const };
+  expect(curve(submission)).toEqual([]);
+  expect(resultsAt([submission], 200)).toEqual([]);
+});
+test("dominated points and equal points have distinct frontier semantics", () => {
+  const points = [
+    { performance: 10, credits: 1 },
+    { performance: 11, credits: 2 },
+  ];
+  expect(onFrontier(points[0], points)).toBe(true);
+  expect(onFrontier(points[1], points)).toBe(false);
+  expect(onFrontier(points[0], [points[0], points[0]])).toBe(true);
+});
diff --git a/apps/challenges-ui/challenges/catalyst/lib/metrics.ts b/apps/challenges-ui/challenges/catalyst/lib/metrics.ts
new file mode 100644
index 00000000..6b91a161
--- /dev/null
+++ b/apps/challenges-ui/challenges/catalyst/lib/metrics.ts
@@ -0,0 +1,92 @@
+import type { JsonValue, PublicSubmission } from "@/shared/lib/yukon-api-client";
+
+export type BudgetView = "best" | 20 | 200;
+export interface Point {
+  performance: number;
+  credits: number;
+}
+export interface Result extends Point {
+  submission: PublicSubmission;
+}
+
+function object(value: JsonValue | undefined): Record<string, JsonValue> | null {
+  return value !== null && typeof value === "object" && !Array.isArray(value) ? value : null;
+}
+function positive(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value) && value > 0;
+}
+function nonnegative(value: unknown): value is number {
+  return typeof value === "number" && Number.isFinite(value) && value >= 0;
+}
+function point(value: JsonValue | undefined): Point | null {
+  const record = object(value);
+  if (!record || !positive(record.performance) || !nonnegative(record.normalized_model_usd)) return null;
+  return { performance: record.performance, credits: record.normalized_model_usd };
+}
+export function performanceFromMetrics(value: JsonValue | null): number | null {
+  const observations = object(value)?.observations;
+  if (!Array.isArray(observations)) return null;
+  const matches = observations.map(object).filter((item) => item?.problem_id === "ecdsa.fail");
+  return matches.length === 1 ? (point(matches[0]?.best)?.performance ?? null) : null;
+}
+function observation(submission: PublicSubmission) {
+  const observations = object(submission.officialMetrics)?.observations;
+  if (!Array.isArray(observations)) return null;
+  const matches = observations.map(object).filter((item) => item?.problem_id === "ecdsa.fail");
+  return matches.length === 1 ? matches[0] : null;
+}
+function measured(submission: PublicSubmission): Point | null {
+  if (["failed", "cancelled", "rejected", "received", "validating"].includes(submission.status)) return null;
+  // A selected packet supersedes legacy judgments, including a later invalidation or human rejection.
+  const packet = submission.evaluation;
+  const valid = packet ? packet.validity.valid && packet.human?.decision !== "reject" : submission.judgment?.valid;
+  const values = packet ? packet.scores.values : submission.judgment?.scores;
+  if (!valid || values?.length !== 2 || !positive(values[0]) || !nonnegative(values[1])) return null;
+  return { performance: values[0], credits: values[1] };
+}
+export function resultAt(submission: PublicSubmission, view: BudgetView): Result | null {
+  const best = measured(submission);
+  if (!best) return null;
+  // The official pair is itself a measured observation, including for older
+  // receipts that only retained their final result. Funding flags are irrelevant.
+  const eligible = [...curve(submission), best]
+    .filter((value) => view === "best" || value.credits <= view)
+    .sort((a, b) => a.performance - b.performance || a.credits - b.credits);
+  return eligible[0] ? { ...eligible[0], submission } : null;
+}
+export function resultsAt(submissions: PublicSubmission[], view: BudgetView): Result[] {
+  return submissions
+    .flatMap((submission) => {
+      const value = resultAt(submission, view);
+      return value ? [value] : [];
+    })
+    .sort(
+      (a, b) =>
+        a.performance - b.performance || a.credits - b.credits || a.submission.id.localeCompare(b.submission.id),
+    );
+}
+export function curve(submission: PublicSubmission): Point[] {
+  const best = measured(submission);
+  if (!best) return [];
+  const values = observation(submission)?.curve;
+  const points = Array.isArray(values)
+    ? values.flatMap((value) => {
+        const parsed = point(value);
+        return parsed ? [parsed] : [];
+      })
+    : [];
+  return (points.length ? points : [best]).sort((a, b) => a.credits - b.credits);
+}
+export function onFrontier(result: Point, results: Point[]): boolean {
+  return !results.some(
+    (other) =>
+      other.performance <= result.performance &&
+      other.credits <= result.credits &&
+      (other.performance < result.performance || other.credits < result.credits),
+  );
+}
+export function formatMetricsSubline(value: JsonValue | null): string | null {
+  const model = object(object(value)?.model);
+  return typeof model?.name === "string" ? model.name : null;
+}
+export const formatCredits = (value: number) => `$${value.toLocaleString("en-US", { maximumFractionDigits: 6 })}`;
