+import type { Metadata } from "next";
+import Script from "next/script";
+import { assertChallengeLive } from "@/shared/lib/challenge-gate";
+
+const TITLE = "Catalyst — Autonomous research, measured";
+const DESCRIPTION =
+  "Compare autonomous research harnesses by verified ECDSA circuit performance and normalized model credits.";
+
+export const metadata: Metadata = {
+  title: TITLE,
+  description: DESCRIPTION,
+  alternates: { canonical: "/catalyst" },
+  openGraph: {
+    title: TITLE,
+    description: DESCRIPTION,
+    siteName: "Catalyst · ECDSA.fail",
+    type: "website",
+    url: "/catalyst",
+    images: [{ url: "/catalyst/opengraph-image", width: 1200, height: 630, alt: TITLE }],
+  },
+  twitter: {
+    card: "summary_large_image",
+    title: TITLE,
+    description: DESCRIPTION,
+    images: ["/catalyst/opengraph-image"],
+  },
+};
+
+export default function CatalystLayout({ children }: { children: React.ReactNode }) {
+  assertChallengeLive("catalyst");
+  return (
+    <div className="challenge-catalyst font-sans">
+      <Script id="reset-catalyst-scroll-on-reload" strategy="beforeInteractive">
+        {`if (location.pathname === "/catalyst" || location.pathname === "/catalyst/") {
+            const isReload = performance.getEntriesByType("navigation")[0]?.type === "reload";
+            history.scrollRestoration = "manual";
+            if (isReload) scrollTo(0, 0);
+          }`}
+      </Script>
+      {children}
+    </div>
+  );
+}
