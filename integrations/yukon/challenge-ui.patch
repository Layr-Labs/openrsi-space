+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import { benchmarkRef } from "@/lib/env";
+import { featuredBenchmarkQuery, viewerKey } from "@/shared/hooks/api";
+import { YukonApiClient } from "@/shared/lib/yukon-api-client";
+
+// Catalyst has one Pareto benchmark. Never fall back to an unrelated board.
+export function useCatalystBenchmark(token: string | null = null) {
+  const ref = benchmarkRef("catalyst") ?? "layr-labs/catalyst";
+  return useQuery(featuredBenchmarkQuery(ref, token));
+}
+
+export function useCatalystSubmissions(benchmarkId: string | undefined, token: string | null = null) {
+  return useQuery({
+    queryKey: viewerKey(["submissions", benchmarkId, "catalyst-history"], token),
+    // Pareto results are not merged; the scalar promoted-only board view omits them.
+    queryFn: () => new YukonApiClient({ baseUrl: "", token }).listBenchmarkSubmissions(benchmarkId ?? ""),
+    enabled: benchmarkId !== undefined,
+    staleTime: 10_000,
+    refetchInterval: 10_000,
+    select: (data) => data.submissions,
+  });
+}
