+            >
+              <title>{`${metrics.score(point.performance)} at ${formatCredits(point.credits)}`}</title>
+            </circle>
+          ))}
+        </svg>
+        <figcaption id={`${id}-caption`} className="mt-3 text-sm text-ink-dim">
+          {best ? (
+            <>
+              Best {view === "best" ? "overall" : `within $${view}`}:{" "}
+              <strong className="font-mono text-ink">{metrics.score(best.performance)}</strong> at{" "}
+              {formatCredits(best.credits)}.
+            </>
+          ) : (
+            <>No recorded verified score within ${view}.</>
+          )}{" "}
+          Credits use pinned model prices and may differ from cash charges.
+        </figcaption>
+      </figure>
+      <details className="mt-4 text-sm text-ink-dim">
+        <summary className="cursor-pointer">
+          View {points.length} recorded evaluation{points.length === 1 ? "" : "s"}
+        </summary>
+        <ol className="mt-3 grid gap-2">
+          {points.map((point, index) => (
+            <li
+              key={`${index}-${point.credits}`}
+              className="flex flex-wrap justify-between gap-2 border-b border-line-faint py-2"
+            >
+              <span>
+                Evaluation {index + 1} · {formatCredits(point.credits)}
+              </span>
+              <span className="font-mono text-ink">{metrics.score(point.performance)}</span>
+            </li>
+          ))}
+        </ol>
+      </details>
+    </section>
+  );
+}
