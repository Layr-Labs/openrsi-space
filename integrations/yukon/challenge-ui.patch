+import { metrics } from "./metric-formatter";
+
+export async function renderCatalystCard(username: string, point: Point, view: BudgetView) {
+  return new ImageResponse(
+    <div
+      style={{
+        display: "flex",
+        flexDirection: "column",
+        width: "100%",
+        height: "100%",
+        padding: 56,
+        background: SHARE_CARD_PALETTE.hero,
+        color: SHARE_CARD_PALETTE.ink,
