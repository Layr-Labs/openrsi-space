+import {
+  buildMetricFormatter,
+  directedDelta,
+  directedPercent,
+  NO_VALUE,
+  signed,
+  type BenchmarkDirection,
+  type MetricFormatter,
+  type MetricFormatterSpec,
+} from "@/shared/lib/metric-formatter";
+
+const number = new Intl.NumberFormat("en-US", { maximumFractionDigits: 2 });
+const SPEC: MetricFormatterSpec = {
+  unit: null,
+  score: (value) => (value == null || !Number.isFinite(value) ? NO_VALUE : number.format(value)),
+  diff: (score, reference, direction) => {
+    const delta = directedDelta(score, reference, direction);
+    const percent = directedPercent(score, reference, direction);
+    return delta === null
+      ? null
+      : `${signed(delta)}${number.format(delta)}${percent === null ? "" : ` (${signed(percent)}${percent.toFixed(2)}%)`}`;
+  },
+  gain: (gain) => `${signed(gain.absolute)}${number.format(gain.absolute)}`,
+  scoreDelta: (value) => `${signed(value)}${number.format(value)}`,
+  animated: (value) => number.format(value),
+  compact: (value) => new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 2 }).format(value),
+};
+export function buildMetrics(direction: BenchmarkDirection): MetricFormatter {
+  return buildMetricFormatter({ ...SPEC, direction });
+}
+export const metrics = buildMetrics("-");
