@@ -0,0 +1,23 @@
+import { dehydrate, QueryClient } from "@tanstack/react-query";
+import { apiUrl, benchmarkRef } from "@/lib/env";
+import { YukonApiClient, type PublicBenchmark } from "@/shared/lib/yukon-api-client";
+
+// Mirror Catalyst's hooks: Pareto needs the full result list, not the
+// promoted-only scalar board. Failed reads remain a client-side retry.
+export async function prefetchCatalystState() {
+  const client = new YukonApiClient({ baseUrl: apiUrl() });
+  const queries = new QueryClient();
+  const ref = benchmarkRef("catalyst") ?? "layr-labs/catalyst";
+  await queries.prefetchQuery({
+    queryKey: ["featured-benchmark", ref],
+    queryFn: async () => (await client.getBenchmark(ref)).benchmark,
+  });
+  const benchmark = queries.getQueryData<PublicBenchmark>(["featured-benchmark", ref]);
+  if (benchmark) {
+    await queries.prefetchQuery({
+      queryKey: ["submissions", benchmark.id, "catalyst-history"],
+      queryFn: () => client.listBenchmarkSubmissions(benchmark.id),
+    });
+  }
+  return dehydrate(queries);
+}
