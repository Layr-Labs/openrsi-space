+"use client";
+import { useRef } from "react";
+import { benchmarkHasEnded } from "@/lib/challenge-status";
+import { useHeroEntrance } from "@/shared/lib/use-hero-entrance";
+import type { PublicBenchmark, PublicSubmission } from "@/shared/lib/yukon-api-client";
+import { withClosedTag } from "@/shared/sections/closed-tag";
+import { curve, resultsAt, formatCredits } from "@/challenges/catalyst/lib/metrics";
+import { metrics } from "@/challenges/catalyst/lib/metric-formatter";
+
+export function Hero({ benchmark, submissions }: { benchmark: PublicBenchmark; submissions: PublicSubmission[] }) {
+  const rootRef = useRef<HTMLDivElement>(null);
+  useHeroEntrance(rootRef);
+  const closed = benchmarkHasEnded(benchmark);
+  const results = resultsAt(submissions, "best");
+  const points = submissions.flatMap(curve);
+  const maxCost = Math.max(1, ...points.map((point) => point.credits));
+  const minScore = Math.min(...points.map((point) => point.performance));
+  const maxScore = Math.max(...points.map((point) => point.performance));
+  return (
+    <div
+      ref={rootRef}
+      data-progress-panel
+      className="relative overflow-hidden rounded-2xl bg-hero px-5 py-6 text-hero-ink shadow-lift sm:px-9 sm:py-10"
+    >
+      <div className="grid items-start gap-7 lg:grid-cols-[minmax(0,1fr)_auto]">
+        <div data-hero-reveal>
+          <p className="mb-4 font-mono text-xs uppercase tracking-widest">Autonomous research · ECDSA.fail</p>
+          {withClosedTag(
+            closed,
+            <h2 className="max-w-3xl text-balance font-display text-4xl leading-tight sm:text-5xl">
+              Verified research progress
+            </h2>,
+          )}
+          <p className="mt-5 max-w-2xl text-sm leading-relaxed">
+            Submit the harness. Measure the research. Compare independently verified quantum circuits by performance and
+            normalized model credits.
+          </p>
+        </div>
+      </div>
+      <div className="research-plot mt-8 grid gap-6 p-5 sm:grid-cols-[1fr_2fr]">
+        <div>
+          <p className="text-xs uppercase tracking-widest">Best verified performance</p>
+          <p className="mt-3 font-mono text-3xl">{results[0] ? metrics.compact(results[0].performance) : "—"}</p>
+          <p className="mt-2 text-sm">average Toffoli × peak qubits</p>
+          <p className="mt-3 text-sm">
+            {results[0]
+              ? `${formatCredits(results[0].credits)} model credits when achieved`
+              : "Awaiting a verified harness result"}
+          </p>
+        </div>
+        <div>
+          {points.length ? (
+            <svg
+              viewBox="0 0 540 165"
+              role="img"
+              aria-label="Verified performance versus cumulative model credits; lower and left are better"
+              className="w-full"
+            >
+              <path d="M40 10V130H520" fill="none" stroke="currentColor" opacity=".5" />
+              {points.map((point, index) => (
+                <circle
+                  key={`${index}-${point.credits}-${point.performance}`}
+                  cx={40 + (460 * point.credits) / maxCost}
+                  cy={110 - (85 * (point.performance - minScore)) / (maxScore - minScore || 1)}
+                  r="5"
+                  fill="currentColor"
+                >
+                  <title>{`${metrics.score(point.performance)} at ${formatCredits(point.credits)}`}</title>
+                </circle>
+              ))}
+              <text x="40" y="155" fill="currentColor" fontSize="11">
+                $0
+              </text>
+              <text x="520" y="155" textAnchor="end" fill="currentColor" fontSize="11">
+                {formatCredits(maxCost)} model credits →
+              </text>
+            </svg>
+          ) : (
+            <p className="py-8 text-sm">The performance–cost curve appears as verified results arrive.</p>
+          )}
+          <p className="text-xs">
+            Each point is a verified evaluation. Lower performance and fewer credits are better.
+          </p>
+        </div>
+      </div>
+    </div>
+  );
+}
