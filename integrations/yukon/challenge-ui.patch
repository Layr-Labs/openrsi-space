+import { boardContributionMetadata } from "@/shared/lib/contribution-metadata";
+import { HydrationBoundary } from "@tanstack/react-query";
+import { prefetchCatalystState } from "@/challenges/catalyst/lib/server-prefetch";
+import { Board } from "./board";
+
+/*
+ * The server half of the route: prefetch the board's benchmark and submissions and prerender the
+ * leaderboard into the HTML, so the first paint is the board rather than a skeleton. Everything the
+ * board IS lives in board.tsx (the client module this route hydrates); the ISR minute cadence and
+ * the fail-open prefetch contract are described in shared/lib/server-prefetch.ts.
+ */
+export const revalidate = 60;
+
+export const generateMetadata = boardContributionMetadata("/catalyst");
+
+export default async function Page() {
+  return (
+    <HydrationBoundary state={await prefetchCatalystState()}>
+      <Board />
+    </HydrationBoundary>
+  );
+}
