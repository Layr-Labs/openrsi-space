@@ -0,0 +1,139 @@
+"use client";
+
+import { useId, useState } from "react";
+import { curve, formatCredits, resultAt, type BudgetView } from "@/challenges/catalyst/lib/metrics";
+import { metrics } from "@/challenges/catalyst/lib/metric-formatter";
+import type { PublicSubmission } from "@/shared/lib/yukon-api-client";
+
+export function PerformanceChart({ submissions, view }: { submissions: PublicSubmission[]; view: BudgetView }) {
+  const id = useId();
+  const runs = submissions.filter((submission) => curve(submission).length > 0);
+  const [selectedId, setSelectedId] = useState("");
+  const selected = runs.find((submission) => submission.id === selectedId) ?? runs[0];
+  if (!selected) return null;
+  const points = curve(selected);
+  const best = resultAt(selected, view);
+  const xMax = Math.max(1, ...points.map((point) => point.credits));
+  const min = Math.min(...points.map((point) => point.performance));
+  const max = Math.max(...points.map((point) => point.performance));
+  const margin = Math.max((max - min) * 0.12, max * 0.005);
+  const yMin = Math.max(0, min - margin);
+  const yMax = max + margin;
+  const x = (cost: number) => 88 + (cost / xMax) * 660;
+  const y = (score: number) => 220 - ((score - yMin) / (yMax - yMin)) * 180;
+  let runningBest = points[0].performance;
+  const steps = points
+    .map((point, index) => {
+      const before = runningBest;
+      runningBest = Math.min(runningBest, point.performance);
+      return index === 0
+        ? `M${x(point.credits)},${y(runningBest)}`
+        : `L${x(point.credits)},${y(before)}L${x(point.credits)},${y(runningBest)}`;
+    })
+    .join(" ");
+
+  return (
+    <section aria-labelledby={`${id}-heading`} className="mt-8 rounded-xl border border-line bg-surface p-4 sm:p-6">
+      <div className="flex flex-wrap items-start justify-between gap-4">
+        <div>
+          <h3 id={`${id}-heading`} className="text-lg font-semibold text-ink">
+            Research progress
+          </h3>
+          <p className="mt-1 text-sm text-ink-dim">
+            Every recorded evaluation stays visible, including regressions. The line shows the best score so far.
+          </p>
+        </div>
+        <label className="grid gap-1 text-xs text-ink-dim">
+          Run
+          <select
+            aria-label="Research run"
+            value={selected.id}
+            onChange={(event) => setSelectedId(event.target.value)}
+            className="max-w-full rounded-md border border-line bg-bg px-3 py-2 text-sm text-ink"
+          >
+            {runs.map((run) => (
+              <option key={run.id} value={run.id}>
+                {run.solverUsername ?? "Anonymous"} · {run.id.slice(0, 8)}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+      <figure className="mt-5">
+        <svg viewBox="0 0 800 270" className="w-full" role="img" aria-labelledby={`${id}-heading ${id}-caption`}>
+          {[0, 0.5, 1].map((fraction) => {
+            const score = yMin + (yMax - yMin) * fraction;
+            return (
+              <g key={fraction} className="text-ink-dim">
+                <line x1="88" x2="748" y1={y(score)} y2={y(score)} stroke="currentColor" opacity=".15" />
+                <text x="76" y={y(score) + 4} textAnchor="end" fill="currentColor" fontSize="12">
+                  {metrics.compact(score)}
+                </text>
+                <text x={x(xMax * fraction)} y="242" textAnchor="middle" fill="currentColor" fontSize="12">
+                  {formatCredits(xMax * fraction)}
+                </text>
+              </g>
+            );
+          })}
+          <text x="88" y="18" className="fill-ink-dim" fontSize="12">
+            Toffoli × qubits ↓
+          </text>
+          <text x="748" y="266" textAnchor="end" className="fill-ink-dim" fontSize="12">
+            Cumulative model credits →
+          </text>
+          {view !== "best" && view <= xMax && (
+            <g className="text-ink-dim">
+              <line x1={x(view)} x2={x(view)} y1="30" y2="220" stroke="currentColor" strokeDasharray="5 5" />
+              <text x={x(view) - 5} y="30" textAnchor="end" fill="currentColor" fontSize="12">
+                ${view}
+              </text>
+            </g>
+          )}
+          <path d={steps} fill="none" className="stroke-accent" strokeWidth="2.5" />
