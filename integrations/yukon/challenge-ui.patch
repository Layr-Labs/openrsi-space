@@ -0,0 +1,30 @@
+import { apiUrl, benchmarkRef } from "@/lib/env";
+import { YukonApiClient } from "@/shared/lib/yukon-api-client";
+import { resultAt, resultsAt } from "@/challenges/catalyst/lib/metrics";
+import { renderCatalystCard } from "@/challenges/catalyst/lib/share-card";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// Pareto results can await review before appearing in the global portfolio.
+// Read their official packets directly; never accept query scores.
+export async function GET(request: Request, { params }: { params: Promise<{ username: string }> }) {
+  const { username } = await params;
+  const search = new URL(request.url).searchParams;
+  const view = search.get("budget") === "20" ? 20 : search.get("budget") === "200" ? 200 : "best";
+  try {
+    const api = new YukonApiClient({ baseUrl: apiUrl() });
+    const { benchmark } = await api.getBenchmark(benchmarkRef("catalyst") ?? "layr-labs/catalyst");
+    const { submissions } = await api.listBenchmarkSubmissions(benchmark.id);
+    const owned = submissions.filter(
+      (submission) => submission.solverUsername?.toLowerCase() === username.toLowerCase(),
+    );
+    const selectedId = search.get("submission");
+    const selected = selectedId ? owned.find((submission) => submission.id === selectedId) : undefined;
+    const result = selectedId ? selected && resultAt(selected, view) : resultsAt(owned, view)[0];
+    if (!result) return new Response("Verified contribution not found", { status: 404 });
+    return await renderCatalystCard(result.submission.solverUsername ?? username, result, view);
+  } catch {
+    return new Response("Verified contribution unavailable", { status: 502 });
+  }
+}
