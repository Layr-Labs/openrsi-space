new file mode 100644
index 00000000..2957906e
--- /dev/null
+++ b/scripts/check-catalyst-ui.ts
@@ -0,0 +1,71 @@
+// Local browser contract check; read-only against Yukon dev, then synthetic
+// browser-only responses for multi-observation budget boundaries.
+import { chromium } from "playwright-core";
+import assert from "node:assert/strict";
+import { SUBMISSIONS } from "../apps/challenges-ui/challenges/catalyst/lib/test-fixtures";
+
+const origin = process.env.CATALYST_UI_URL ?? "http://localhost:3000";
+const browser = await chromium.launch({ channel: "chrome", headless: true });
+try {
+  const page = await browser.newPage({ viewport: { width: 1440, height: 1100 } });
+  const errors: string[] = [];
+  page.on("pageerror", (error) => errors.push(error.message));
+  await page.goto(`${origin}/catalyst?as=bxue-l2`, { waitUntil: "networkidle" });
+  const matrix = page.getByRole("table", { name: "Harness performance by model-credit budget" });
+  const original = matrix.locator("#result-8c672862-fdce-43fe-a66c-09ce10bf24b2");
+  assert.equal(await matrix.getByRole("columnheader").count(), 4);
+  for (const view of ["Within $20", "Within $200", "Best overall"]) {
+    await page.getByRole("button", { name: view, exact: true }).click();
+    assert.equal(await original.getByText("10,704,574,395", { exact: true }).count(), 3);
+    assert.equal(await original.getByText("$0.887796 credits", { exact: true }).count(), 3);
+  }
+  await page.screenshot({ path: "/tmp/catalyst-ui-desktop.png", fullPage: true });
+  await original.getByRole("button", { name: "Share", exact: true }).click();
+  await page.waitForFunction(() =>
+    Array.from(document.querySelectorAll("dialog img, [role=dialog] img"))
+      .some((image) => (image as HTMLImageElement).complete && (image as HTMLImageElement).naturalWidth > 0),
+  );
+  await page.waitForTimeout(350); // Let the existing share-image entrance finish.
+  await page.screenshot({ path: "/tmp/catalyst-ui-share.png" });
+  await page.goto(`${origin}/solver/bxue-l2?as=bxue-l2`, { waitUntil: "networkidle" });
+  await page.getByRole("heading", { name: /bxue-l2/ }).first().waitFor();
+
+  await page.route("**/api/benchmarks/*/submissions*", (route) =>
+    route.fulfill({ json: { submissions: [...SUBMISSIONS, {
+      ...SUBMISSIONS[0], id: "late-result", solverUsername: "late",
+      judgment: { valid: true, scores: [9_000_000_000, 201] }, officialMetrics: null,
+    }] } }),
+  );
+  await page.goto(`${origin}/catalyst?solver=grace&budget=20`, { waitUntil: "networkidle" });
+  await matrix.getByText("10,600,000,000", { exact: true }).waitFor({ timeout: 30_000 });
+  const grace = matrix.locator('tr[data-solver="grace"]');
+  const late = matrix.locator('tr[data-solver="late"]');
+  assert.match(await grace.getByRole("cell").nth(0).innerText(), /10,600,000,000\s+\$19 credits/);
+  assert.match(await grace.getByRole("cell").nth(1).innerText(), /10,000,000,000\s+\$25 credits/);
+  assert.match(await grace.getByRole("cell").nth(2).innerText(), /10,000,000,000\s+\$25 credits/);
+  assert.equal(await late.getByRole("cell").nth(0).innerText(), "—");
+  assert.equal(await late.getByRole("cell").nth(1).innerText(), "—");
+  assert.match(await late.getByRole("cell").nth(2).innerText(), /9,000,000,000/);
+  assert.equal(await matrix.locator("tbody tr").count(), 3);
+  assert.equal(await matrix.locator("tbody tr").first().getAttribute("data-solver"), "grace");
+  await page.getByRole("button", { name: "Best overall", exact: true }).click();
+  assert.equal(await matrix.locator("tbody tr").first().getAttribute("data-solver"), "late");
+  assert.equal(await matrix.locator("tbody tr").count(), 3);
+  await page.getByLabel("Research run", { exact: true }).selectOption("verified-grace");
+  await page.getByRole("button", { name: "Within $200", exact: true }).click();
+  assert.equal(await matrix.locator("tbody tr").first().getAttribute("data-solver"), "grace");
+  await page.getByText("View 2 recorded evaluations", { exact: true }).click();
+  await page.getByText("Evaluation 1 · $19", { exact: true }).waitFor();
+  await page.getByText("Evaluation 2 · $25", { exact: true }).waitFor();
+  await page.screenshot({ path: "/tmp/catalyst-ui-history.png", fullPage: true });
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.getByRole("button", { name: "Within $20", exact: true }).click();
+  const overflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);
+  if (overflow) throw new Error("Mobile page overflows its viewport.");
+  await page.screenshot({ path: "/tmp/catalyst-ui-mobile.png", fullPage: true });
+  if (errors.length) throw new Error(errors.join("\n"));
+  console.log("Live matrix, all budget cells, missing observations, column ranking, sharing, history, and mobile layout passed.");
+} finally {
+  await browser.close();
+}
+process.exit(0);
