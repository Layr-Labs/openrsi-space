@@ -0,0 +1,195 @@
+"use client";
+import { useEffect, useMemo, useState } from "react";
+import Link from "next/link";
+import { SECTION_CONFIG } from "@/challenges/catalyst";
+import { metrics } from "@/challenges/catalyst/lib/metric-formatter";
+import {
+  formatCredits,
+  formatMetricsSubline,
+  onFrontier,
+  resultAt,
+  resultsAt,
+  type BudgetView,
+} from "@/challenges/catalyst/lib/metrics";
+import type { PublicBenchmark, PublicSubmission } from "@/shared/lib/yukon-api-client";
+import { LocalTime } from "@/shared/components/local-time";
+import { ShareContributionButton } from "@/shared/sections/share-contribution-button";
+import { solverProfileHref } from "@/shared/lib/solver-profile-href";
+import { PerformanceChart } from "./performance-chart";
+
+const COLUMNS = [
+  { budget: 20, label: "Within $20" },
+  { budget: 200, label: "Within $200" },
+  { budget: "best", label: "Best overall" },
+] as const;
+
+export function Leaderboard({
+  benchmark,
+  submissions,
+  viewerUsername,
+}: {
+  benchmark: PublicBenchmark;
+  submissions: PublicSubmission[];
+  viewerUsername?: string | null;
+}) {
+  const [view, setView] = useState<BudgetView>("best");
+  useEffect(() => {
+    const budget = new URLSearchParams(window.location.search).get("budget");
+    if (budget === "20" || budget === "200") setView(Number(budget) as 20 | 200);
+  }, []);
+  const columns = useMemo(
+    () => COLUMNS.map((column) => ({ ...column, results: resultsAt(submissions, column.budget) })),
+    [submissions],
+  );
+  const rows = useMemo(() => {
+    const all = resultsAt(submissions, "best").map((result, index) => ({ ...result, overallRank: index + 1 }));
+    // Sorting changes row order only. A missing budget result stays in the
+    // matrix, after measured results, with its other budget cells intact.
+    return all.sort((a, b) => {
+      const left = resultAt(a.submission, view);
+      const right = resultAt(b.submission, view);
+      if (!left) return right ? 1 : a.overallRank - b.overallRank;
+      if (!right) return -1;
+      return left.performance - right.performance || left.credits - right.credits || a.overallRank - b.overallRank;
+    });
+  }, [submissions, view]);
+  // biome-ignore lint/correctness/useExhaustiveDependencies: rows retriggers scrolling when results become visible.
+  useEffect(() => {
+    const solver = new URLSearchParams(window.location.search).get("solver")?.trim().toLowerCase();
+    if (!solver) return;
+    Array.from(document.querySelectorAll<HTMLElement>("[data-solver]"))
+      .find((row) => row.dataset.solver === solver && row.getClientRects().length > 0)
+      ?.scrollIntoView({ behavior: "smooth", block: "center" });
+  }, [rows]);
+  return (
+    <section aria-label="Verified harness results" className="min-w-0">
+      <h2 className="mb-3 text-xl font-semibold text-ink">Verified harness results</h2>
+      <p className="mb-4 text-sm text-ink-dim">
+        Compare every budget side by side. Each cell shows the best verified Toffoli × qubits and credits used. Lower is
+        better. Select a column to rank by that budget.
+      </p>
+      {rows.length === 0 ? (
+        <p className="rounded-xl border border-line p-8 text-center text-ink-dim">No verified harness results yet.</p>
+      ) : (
+        <div className="overflow-x-auto rounded-xl border border-line">
+          <table
+            aria-label="Harness performance by model-credit budget"
+            className="w-full min-w-[760px] text-left text-sm"
+          >
+            <thead className="bg-surface text-ink-dim">
+              <tr>
+                <th scope="col" className="sticky left-0 z-10 bg-bg p-4">
+                  Harness / solver
+                </th>
+                {columns.map(({ budget, label }) => (
+                  <th
+                    key={budget}
+                    scope="col"
+                    aria-sort={view === budget ? "ascending" : undefined}
+                    className={`border-l border-line p-4 ${view === budget ? "bg-accent-soft text-accent-strong" : ""}`}
+                  >
+                    <button
+                      type="button"
+                      onClick={() => setView(budget)}
+                      aria-pressed={view === budget}
+                      className="rounded-sm text-left underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
+                    >
+                      {label} <span aria-hidden="true">{view === budget ? "↓" : "↕"}</span>
+                    </button>
+                    <p className="mt-1 text-xs font-normal text-ink-dim">Toffoli × qubits</p>
+                  </th>
+                ))}
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((row) => {
+                const submission = row.submission;
+                const username = submission.solverUsername;
+                const model = formatMetricsSubline(submission.officialMetrics);
+                return (
+                  <tr
+                    key={submission.id}
+                    id={`result-${submission.id}`}
+                    data-solver={username?.toLowerCase()}
+                    className="border-t border-line text-ink"
+                  >
+                    <th scope="row" className="sticky left-0 z-10 bg-bg p-4 font-normal">
+                      {username ? (
+                        <Link
+                          href={solverProfileHref(username, { benchmark: benchmark.id })}
+                          className="font-medium text-accent-strong"
+                        >
+                          {username}
+                        </Link>
+                      ) : (
+                        "Anonymous"
+                      )}
+                      {model && <p className="mt-1 text-xs text-ink-dim">{model}</p>}
+                      <p className="mt-1 font-mono text-xs text-ink-dim">Run {submission.id.slice(0, 8)}</p>
+                      <p className="mt-1 text-xs text-ink-dim">
+                        <LocalTime at={submission.createdAt} />
+                      </p>
+                      {username?.toLowerCase() === viewerUsername?.toLowerCase() && username && (
+                        <ShareContributionButton
+                          routePrefix="/catalyst"
+                          slug="catalyst"
+                          modal={SECTION_CONFIG.modal}
+                          variant="surface"
+                          facts={{
+                            username,
+                            challengeName: "Catalyst",
+                            rank: row.overallRank,
+                            solverCount: rows.length,
+                            promotedCount: 0,
+                            bestScore: metrics.score(row.performance),
+                            gain: "—",
+                            isChampion: row.overallRank === 1,
+                          }}
+                          shareText={(facts) =>
+                            `My Catalyst harness achieved ${facts.bestScore} Toffoli × qubits at ${formatCredits(row.credits)} model credits.`
+                          }
+                          sharePath={`/catalyst?solver=${encodeURIComponent(username)}`}
+                          cardPath={`/catalyst/solver/${encodeURIComponent(username)}/card.png?submission=${encodeURIComponent(submission.id)}&budget=best`}
+                        />
+                      )}
+                    </th>
+                    {columns.map(({ budget, results }) => {
+                      const point = resultAt(submission, budget);
+                      return (
+                        <td
+                          key={budget}
+                          className={`border-l border-line p-4 ${view === budget ? "bg-accent-soft/40" : ""}`}
+                        >
+                          {point ? (
+                            <>
+                              <p className="font-mono font-medium tabular-nums">{metrics.score(point.performance)}</p>
+                              <p className="mt-1 font-mono text-xs tabular-nums text-ink-dim">
+                                {formatCredits(point.credits)} credits
+                              </p>
+                              {onFrontier(point, results) && (
+                                <p className="mt-2 text-xs text-accent-strong">Frontier</p>
+                              )}
+                            </>
+                          ) : (
+                            <span className="text-ink-faint" aria-label={`No verified result within $${budget}`}>
+                              —
+                            </span>
+                          )}
+                        </td>
+                      );
+                    })}
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      )}
+      <p className="mt-3 text-xs text-ink-dim">
+        A cheaper run qualifies for both budget columns. — means no verified observation within that budget. Frontier
+        marks results unbeaten on both performance and credits in that column.
+      </p>
+      <PerformanceChart submissions={submissions} view={view} />
+    </section>
+  );
+}
