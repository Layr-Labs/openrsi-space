+      }}
+    >
+      <div style={{ display: "flex", justifyContent: "space-between", fontSize: 32 }}>
+        <span>Yukon / Catalyst</span>
+        <span>Verified ECDSA research</span>
+      </div>
+      <span style={{ marginTop: 40, fontSize: 28 }}>@{username}</span>
+      <span style={{ marginTop: 36, fontSize: 22 }}>Best {view === "best" ? "overall" : `within $${view}`}</span>
+      <span style={{ marginTop: 16, fontSize: 60, fontFamily: "JetBrains Mono" }}>
+        {metrics.score(point.performance)}
+      </span>
+      <span style={{ marginTop: 10, fontSize: 24 }}>average Toffoli × peak qubits · lower is better</span>
+      <span style={{ marginTop: 32, fontSize: 30 }}>{formatCredits(point.credits)} model credits when achieved</span>
+      <span style={{ marginTop: 32, fontSize: 18 }}>
+        Pinned prices · credits may differ from cash charges · yukon.org/catalyst
+      </span>
+    </div>,
+    { ...SHARE_CARD_SIZE, fonts: await loadCardFonts() },
+  );
+}
