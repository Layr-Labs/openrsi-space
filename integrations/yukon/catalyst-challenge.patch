index 00000000..cfdbdab4
--- /dev/null
+++ b/apps/challenges-ui/challenges/catalyst/lib/metrics.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, test } from "bun:test";
+import { BENCHMARK, SUBMISSIONS } from "./fixture-data";
+import { buildMatrix, comparisonKey, measuredAttempts, problemKey, readMeasurement } from "./metrics";
+
+const eligible = measuredAttempts(SUBMISSIONS);
+const comparison = comparisonKey(eligible[0].measurement);
+function rankAt(budget: number, problemId = "accuracy") {
+  const matrix = buildMatrix(SUBMISSIONS, budget, comparison);
+  const problem = matrix.problems.find((problem) => problem.id === problemId)!;
+  return matrix.rows
+    .filter((row) => row.cells.get(problemKey(problem))?.score != null)
+    .sort((a, b) => {
+      const left = a.cells.get(problemKey(problem))!.score!;
+      const right = b.cells.get(problemKey(problem))!.score!;
+      return problem.metric.direction === "+" ? right - left : left - right;
+    })
+    .map((row) => row.measurement.harness.id);
+}
+describe("native performance within recorded cost", () => {
+  test("budget changes ordering for both maximization and minimization", () => {
+    expect(rankAt(0.75)[0]).toBe("direct");
+    expect(rankAt(8)[0]).toBe("planner");
+    expect(rankAt(0.75, "error")[0]).toBe("direct");
+    expect(rankAt(8, "error")[0]).toBe("planner");
+  });
