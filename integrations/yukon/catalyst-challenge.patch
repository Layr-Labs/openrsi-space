+"use client";
+
+import { useQueries, useQuery } from "@tanstack/react-query";
+import { benchmarkRef } from "@/lib/env";
+import { featuredBenchmarkQuery, viewerKey } from "@/shared/hooks/api";
+import { YukonApiClient, type PublicSubmission } from "@/shared/lib/yukon-api-client";
+
+const api = (token: string | null) => new YukonApiClient({ baseUrl: "", token });
+const ref = benchmarkRef("catalyst") ?? "";
+
+// Unlike the general board fallback, an unconfigured Catalyst board must not display
+// whichever unrelated challenge happens to be newest.
+export function useCatalystBenchmark(token: string | null = null) {
+  const query = useQuery({ ...featuredBenchmarkQuery(ref, token), enabled: ref.length > 0 });
+  return { ...query, data: ref.length === 0 ? null : query.data, isPending: ref.length > 0 && query.isPending };
+}
+
+export function useCatalystSubmissions(benchmarkId: string | undefined, token: string | null = null) {
+  const catalog = useQuery({
+    queryKey: viewerKey(["benchmarks"], token),
+    queryFn: () => api(token).listBenchmarks(),
+    enabled: benchmarkId !== undefined,
+    staleTime: 10_000,
+  });
+  const anchor = catalog.data?.benchmarks.find((benchmark) => benchmark.id === benchmarkId);
+  const tracks =
+    anchor?.challengeId == null
+      ? benchmarkId
+        ? [benchmarkId]
+        : []
+      : catalog
+          .data!.benchmarks.filter(
+            (benchmark) => benchmark.challengeId === anchor.challengeId && benchmark.mode === "pareto",
+          )
+          .map((benchmark) => benchmark.id);
+  const queries = useQueries({
+    queries: tracks.map((id) => ({
+      queryKey: viewerKey(["submissions", id, "all"], token),
+      queryFn: () => api(token).listBenchmarkSubmissions(id),
+      staleTime: 10_000,
+      refetchInterval: 10_000,
+    })),
+  });
+  const isPending = benchmarkId !== undefined && (catalog.isPending || queries.some((query) => query.isPending));
+  const isLoadingError = catalog.isLoadingError || queries.some((query) => query.isLoadingError);
+  return {
+    data:
+      isPending || isLoadingError
+        ? undefined
+        : (queries.flatMap((query) => query.data?.submissions ?? []) as PublicSubmission[]),
+    isPending,
+    isLoadingError,
+    isFetching: catalog.isFetching || queries.some((query) => query.isFetching),
+    refetch: () => Promise.all([catalog.refetch(), ...queries.map((query) => query.refetch())]),
+  };
+}
