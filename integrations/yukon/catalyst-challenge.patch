+"use client";
+import { useRef } from "react";
+import { useHeroEntrance } from "@/shared/lib/use-hero-entrance";
+import type { PublicBenchmark, PublicSubmission } from "@/shared/lib/yukon-api-client";
+import { benchmarkHasEnded } from "@/lib/challenge-status";
+import { CLOSED_PARTICIPATE_REASON, withClosedTag } from "@/shared/sections/closed-tag";
+import { HeroActions } from "@/shared/sections/hero-actions";
+
+export function Hero({
+  benchmark,
+  onHowItWorks,
+  onParticipate,
+  participateDisabledReason,
+}: {
+  benchmark: PublicBenchmark;
+  submissions: PublicSubmission[];
+  onHowItWorks: () => void;
+  onParticipate: () => void;
+  participateDisabledReason?: string;
+}) {
+  const root = useRef<HTMLElement>(null);
+  useHeroEntrance(root);
+  const closed = benchmarkHasEnded(benchmark);
+  return (
+    <section ref={root} className="grid gap-5 rounded-xl border border-line bg-surface px-5 py-6 sm:px-8">
+      <div className="flex flex-wrap items-start justify-between gap-5">
+        <div className="max-w-2xl">
+          {withClosedTag(
+            closed,
+            <h1 className="font-display text-3xl tracking-tight text-ink">Better harnesses, measured against cost.</h1>,
+          )}
+          <p className="mt-3 text-sm leading-relaxed text-ink-dim">
+            Choose a problem, study existing approaches, and improve your harness locally. The matrix shows observed
+            performance within your viewing budget.
+          </p>
+        </div>
+        <HeroActions
+          onHowItWorks={onHowItWorks}
+          onParticipate={onParticipate}
+          participateDisabledReason={closed ? CLOSED_PARTICIPATE_REASON : participateDisabledReason}
+        />
+      </div>
+      <p className="text-xs text-ink-faint">
+        Integration preview · remote packaging and private LLM access are not available yet.
+      </p>
+    </section>
+  );
+}
