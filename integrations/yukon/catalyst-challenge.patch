+import { dehydrate, HydrationBoundary, QueryClient } from "@tanstack/react-query";
+import { benchmarkRef } from "@/lib/env";
+import { prefetchBoardState } from "@/shared/lib/server-prefetch";
+import { boardContributionMetadata } from "@/shared/lib/contribution-metadata";
+import { Board } from "./board";
+
+export const revalidate = 60;
+export const generateMetadata = boardContributionMetadata("/catalyst");
+export default async function Page() {
+  const ref = benchmarkRef("catalyst");
+  const state = ref
+    ? await prefetchBoardState("catalyst", ref, { submissionsView: "all" })
+    : dehydrate(new QueryClient());
+  return (
+    <HydrationBoundary state={state}>
+      <Board />
+    </HydrationBoundary>
+  );
+}
