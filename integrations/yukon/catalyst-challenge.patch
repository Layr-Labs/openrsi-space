diff --git a/apps/challenges-ui/challenges/catalyst/lib/metrics.ts b/apps/challenges-ui/challenges/catalyst/lib/metrics.ts
new file mode 100644
index 00000000..1aa477f2
--- /dev/null
+++ b/apps/challenges-ui/challenges/catalyst/lib/metrics.ts
@@ -0,0 +1,225 @@
+import type { PublicSubmission, JsonValue } from "@/shared/lib/yukon-api-client";
+
+export interface Problem {
+  id: string;
+  version: string;
+  title: string;
+  metric: { name: string; unit: string | null; direction: "+" | "-" };
+}
+export interface Observation {
+  cost: number;
+  score: number;
+}
+export interface Measurement {
+  evaluationId: string;
+  evidence: "platform-verified" | "fixture";
+  sourceDigest: string;
+  imageDigest: string;
+  problem: Problem;
+  harness: { id: string; version: string; title: string };
+  model: string;
+  conditions: string;
+  observations: Observation[];
+}
+
+function record(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+function text(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+function digest(value: unknown): value is string {
+  return typeof value === "string" && /^[a-f0-9]{64}$/.test(value);
+}
+
+/** This blob must come from the trusted judge's officialMetrics, never a note or claimed score. */
+export function readMeasurement(metrics: JsonValue | null): Measurement | null {
+  const data = record(record(metrics)?.catalyst);
+  if (data === null || data.schemaVersion !== 1) return null;
+  const problem = record(data.problem);
+  const metric = record(problem?.metric);
+  const harness = record(data.harness);
+  if (
+    problem === null ||
+    metric === null ||
+    harness === null ||
+    !text(data.evaluationId) ||
+    !digest(data.sourceDigest) ||
+    typeof data.imageDigest !== "string" ||
+    !/^sha256:[a-f0-9]{64}$/.test(data.imageDigest) ||
+    !text(problem.id) ||
+    !digest(problem.version) ||
+    !text(problem.title) ||
+    !text(metric.name) ||
+    !(metric.unit === null || typeof metric.unit === "string") ||
+    !(metric.direction === "+" || metric.direction === "-") ||
+    !text(harness.id) ||
+    !digest(harness.version) ||
+    !text(harness.title) ||
+    !text(data.model) ||
+    !text(data.conditions) ||
+    !(data.evidence === "platform-verified" || data.evidence === "fixture") ||
+    !Array.isArray(data.observations) ||
+    data.observations.length === 0
+  )
+    return null;
+  const observations: Observation[] = [];
+  let previousCost = -1;
+  for (const raw of data.observations) {
+    const point = record(raw);
+    if (
+      point === null ||
+      typeof point.cost !== "number" ||
+      !Number.isFinite(point.cost) ||
+      point.cost < 0 ||
+      point.cost < previousCost ||
+      typeof point.score !== "number" ||
+      !Number.isFinite(point.score)
+    )
+      return null;
+    observations.push({ cost: point.cost, score: point.score });
+    previousCost = point.cost;
+  }
+  return {
+    evaluationId: data.evaluationId,
+    evidence: data.evidence,
+    sourceDigest: data.sourceDigest,
+    imageDigest: data.imageDigest,
+    problem: {
+      id: problem.id,
+      version: problem.version,
+      title: problem.title,
+      metric: { name: metric.name, unit: metric.unit, direction: metric.direction },
+    },
+    harness: { id: harness.id, version: harness.version, title: harness.title },
+    model: data.model,
+    conditions: data.conditions,
+    observations,
+  };
+}
+
+export function isEligible(submission: PublicSubmission): boolean {
+  const packet = submission.evaluation;
+  return (
+    submission.status === "accepted" &&
+    packet != null &&
+    packet.validity.valid &&
+    packet.human?.decision !== "reject" &&
+    packet.scores.values !== null &&
+    packet.scores.values.length > 0 &&
+    packet.scores.values.every(Number.isFinite)
+  );
+}
+
+export function problemKey(problem: Problem): string {
+  return JSON.stringify([problem.id, problem.version, problem.metric]);
+}
+export function harnessKey(measurement: Measurement): string {
+  return JSON.stringify([measurement.harness.id, measurement.harness.version, measurement.sourceDigest]);
+}
+export function comparisonKey(measurement: Measurement): string {
+  return JSON.stringify([measurement.model, measurement.conditions, measurement.evidence]);
+}
+function median(values: number[]): number {
+  const sorted = [...values].sort((a, b) => a - b);
+  const middle = Math.floor(sorted.length / 2);
+  return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
+}
+export interface Attempt {
+  submission: PublicSubmission;
+  measurement: Measurement;
+}
+export interface Cell {
+  score: number | null;
+  cost: number | null;
+  recorded: number;
+  eligible: number;
+  frontier: boolean;
+  attempts: Attempt[];
+}
+export interface MatrixRow {
+  key: string;
+  measurement: Measurement;
+  submission: PublicSubmission;
+  cells: Map<string, Cell>;
+}
+
+export function measuredAttempts(submissions: PublicSubmission[]): Attempt[] {
+  const seen = new Set<string>();
+  return submissions.flatMap((submission) => {
+    const measurement = readMeasurement(submission.officialMetrics);
+    if (measurement === null || !isEligible(submission)) return [];
+    // A retry or duplicated public record must not become another repetition.
+    const identity = JSON.stringify([measurement.evaluationId, problemKey(measurement.problem)]);
+    if (seen.has(identity)) return [];
+    seen.add(identity);
+    return [{ submission, measurement }];
+  });
+}
+
+export function buildMatrix(
+  submissions: PublicSubmission[],
+  budget: number,
+  comparison: string,
+): { rows: MatrixRow[]; problems: Problem[] } {
+  if (!Number.isFinite(budget) || budget < 0) return { rows: [], problems: [] };
+  const attempts = measuredAttempts(submissions).filter(({ measurement }) => comparisonKey(measurement) === comparison);
+  const problems = [
+    ...new Map(attempts.map(({ measurement }) => [problemKey(measurement.problem), measurement.problem])).values(),
+  ];
+  const rows = new Map<string, MatrixRow>();
+  for (const attempt of attempts) {
+    const { measurement, submission } = attempt;
+    const key = harnessKey(measurement);
+    const row = rows.get(key) ?? { key, measurement, submission, cells: new Map<string, Cell>() };
+    const pk = problemKey(measurement.problem);
+    const cell = row.cells.get(pk) ?? {
+      score: null,
+      cost: null,
+      recorded: 0,
+      eligible: 0,
+      frontier: false,
+      attempts: [],
+    };
+    cell.recorded += 1;
+    cell.attempts.push(attempt);
+    row.cells.set(pk, cell);
+    rows.set(key, row);
+  }
+  for (const row of rows.values()) {
+    for (const cell of row.cells.values()) {
+      const points = cell.attempts.flatMap(({ measurement }) => {
+        const observed = measurement.observations.filter((point) => point.cost <= budget);
+        const direction = measurement.problem.metric.direction;
+        const best = observed.reduce<Observation | null>(
+          (current, point) =>
+            current === null || (direction === "+" ? point.score > current.score : point.score < current.score)
+              ? point
+              : current,
+          null,
+        );
+        return best === null ? [] : [best];
+      });
+      cell.eligible = points.length;
+      if (points.length) {
+        cell.score = median(points.map((point) => point.score));
+        cell.cost = median(points.map((point) => point.cost));
+      }
+    }
+  }
+  for (const problem of problems) {
+    const cells = [...rows.values()].flatMap((row) => {
+      const cell = row.cells.get(problemKey(problem));
+      return cell?.score == null || cell.cost === null ? [] : [cell];
+    });
+    for (const cell of cells) {
+      cell.frontier = !cells.some((other) => {
+        const better = problem.metric.direction === "+" ? other.score! >= cell.score! : other.score! <= cell.score!;
+        return better && other.cost! <= cell.cost! && (other.score !== cell.score || other.cost !== cell.cost);
+      });
+    }
+  }
+  return { rows: [...rows.values()], problems };
+}
