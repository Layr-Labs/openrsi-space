+import type { ParetoEvaluationPacket } from "@yukon/api-client";
+import type { PublicBenchmark, PublicSubmission, JsonValue } from "@/shared/lib/yukon-api-client";
+
+export const FIXTURE_BENCHMARK_ID = "ca7a1000-0000-4000-8000-000000000001";
+const GROUP_ID = "ca7a1000-0000-4000-8000-000000000000";
+const createdAt = "2026-06-15T00:00:00.000Z";
+const hash = (character: string) => character.repeat(64);
+export const BENCHMARK: PublicBenchmark = {
+  id: FIXTURE_BENCHMARK_ID,
+  challengeId: GROUP_ID,
+  trackName: "accuracy",
+  mode: "pareto",
+  objectives: [
+    { name: "performance", direction: "+" },
+    { name: "model_cost_usd", direction: "-" },
+  ],
+  status: "open",
+  name: "eigenlabs/catalyst/accuracy",
+  description: "Synthetic Catalyst fixture; not a live challenge.",
+  category: "harness",
+  direction: "+",
+  maxSubmissionBytes: null,
+  sourceUrl: "https://github.com/Layr-Labs/yukon",
+  sourceRef: "a".repeat(40),
+  baselineScore: null,
+  baselineMetrics: null,
+  currentBestScore: null,
+  currentBestMetrics: null,
+  closesAt: null,
+  openedAt: createdAt,
+  createdAt,
+  updatedAt: createdAt,
+};
+export const BENCHMARKS: PublicBenchmark[] = [
+  BENCHMARK,
+  {
+    ...BENCHMARK,
+    id: "ca7a1000-0000-4000-8000-000000000002",
+    trackName: "error",
+    name: "eigenlabs/catalyst/error",
+    direction: "-",
+    objectives: [
+      { name: "performance", direction: "-" },
+      { name: "model_cost_usd", direction: "-" },
+    ],
+  },
+];
+const curves = {
+  direct: [
+    { cost: 0.25, score: 0.6 },
+    { cost: 0.75, score: 0.76 },
+    { cost: 3, score: 0.8 },
+  ],
+  planner: [
+    { cost: 1, score: 0.5 },
+    { cost: 2.5, score: 0.78 },
+    { cost: 5, score: 0.92 },
+    { cost: 8, score: 0.96 },
+  ],
+  notes: [
+    { cost: 0.5, score: 0.65 },
+    { cost: 1.5, score: 0.82 },
+    { cost: 3, score: 0.88 },
+    { cost: 6, score: 0.9 },
+  ],
+};
+
+function submission(harness: keyof typeof curves, problem: number, repeat: number): PublicSubmission {
+  const id = `fixture-${harness}-${problem}-${repeat}`;
+  const benchmark = BENCHMARKS[problem];
+  const sourceDigest = hash(harness === "direct" ? "d" : harness === "planner" ? "a" : "b");
+  const observations = curves[harness].map(({ cost, score }) => ({
+    cost,
+    score: Number((problem === 0 ? score + (repeat - 1) * 0.01 : 1 - score - (repeat - 1) * 0.01).toFixed(4)),
+  }));
+  const evidence = {
+    resultId: id,
+    evaluatorId: "fixture-judge",
+    policyVersionId: "fixture-policy",
+    sourceRef: benchmark.sourceRef,
+    jobId: id,
+    commitSha: sourceDigest.slice(0, 40),
+    evaluatedAt: createdAt,
+  };
+  const packet: ParetoEvaluationPacket = {
+    id: `${id}-packet`,
+    candidateKey: sourceDigest,
+    evaluationId: "fixture-policy",
+    validityVersionId: "fixture-validity",
+    scores: { values: [observations.at(-1)!.score, observations.at(-1)!.cost], evidence },
+    validity: { valid: true, reason: null, evidence },
+    human: null,
+    previousHuman: null,
+  };
+  const officialMetrics: JsonValue = {
+    catalyst: {
+      schemaVersion: 1,
+      evidence: "fixture",
+      evaluationId: id,
+      sourceDigest,
+      imageDigest: `sha256:${sourceDigest}`,
+      problem: {
+        id: problem === 0 ? "accuracy" : "error",
+        version: hash(problem === 0 ? "c" : "e"),
+        title: problem === 0 ? "Reconstruction accuracy" : "Reconstruction error",
+        metric: { name: problem === 0 ? "accuracy" : "error", unit: null, direction: benchmark.direction },
+      },
+      harness: {
+        id: harness,
+        version: sourceDigest,
+        title: harness === "direct" ? "Direct approach" : harness === "planner" ? "Planning approach" : "Curated notes",
+      },
+      model: "synthetic-demo-model",
+      conditions: "fixture-policy-v1",
+      observations,
+    },
+  };
+  return {
+    id,
+    benchmarkId: benchmark.id,
+    solverAccountId: `fixture-${harness}`,
+    solverUsername: harness === "direct" ? "ada" : harness === "planner" ? "turing" : "noether",
+    solverAvatarUrl: null,
+    solverProfileUrl: null,
+    status: "accepted",
+    note: "Synthetic fixture only.",
+    claimedScore: null,
+    officialScore: observations.at(-1)!.score,
+    officialMetrics,
+    evaluation: packet,
+    improved: null,
+    rejectionReason: null,
+    submissionCommitSha: sourceDigest.slice(0, 40),
+    promotionStatus: null,
+    promotionReason: null,
+    promotionSnapshotRef: null,
+    promotedSourceRef: null,
+    createdAt,
+    updatedAt: createdAt,
+  };
+}
+export const SUBMISSIONS: PublicSubmission[] = BENCHMARKS.flatMap((_, problem) =>
+  (Object.keys(curves) as Array<keyof typeof curves>).flatMap((harness) =>
+    [0, 1, 2].map((repeat) => submission(harness, problem, repeat)),
+  ),
+);
+const invalid = submission("planner", 0, 9);
+SUBMISSIONS.push({
+  ...invalid,
+  id: "fixture-invalid",
+  status: "rejected",
+  evaluation: {
+    ...invalid.evaluation!,
+    validity: {
+      ...invalid.evaluation!.validity,
+      valid: false,
+      reason: "Harness violated the candidate-output contract.",
+    },
+  },
+});
+SUBMISSIONS.push({
+  ...submission("direct", 0, 10),
+  id: "fixture-failed",
+  status: "failed",
+  officialScore: null,
+  officialMetrics: null,
+  evaluation: null,
+  rejectionReason: "Worker timed out before producing a judgment.",
+});
