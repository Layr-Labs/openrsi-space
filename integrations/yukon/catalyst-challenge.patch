diff --git a/scripts/catalyst-fixture-api.ts b/scripts/catalyst-fixture-api.ts
new file mode 100644
index 00000000..eb1b8c24
--- /dev/null
+++ b/scripts/catalyst-fixture-api.ts
@@ -0,0 +1,139 @@
+/**
+ * Explicit read-only synthetic API for the Catalyst integration preview.
+ * It has no submission, credential, build, or model endpoints.
+ */
+import {
+	BENCHMARKS,
+	FIXTURE_BENCHMARK_ID,
+	SUBMISSIONS,
+} from "../apps/challenges-ui/challenges/catalyst/lib/fixture-data";
+
+const portArg = process.argv.indexOf("--port");
+const port = portArg >= 0 ? Number(process.argv[portArg + 1]) : 8099;
+const json = (value: unknown, status = 200) => Response.json(value, { status });
+const server = Bun.serve({
+	hostname: "127.0.0.1",
+	port,
+	fetch(request) {
+		const url = new URL(request.url);
+		if (request.method !== "GET")
+			return json(
+				{
+					error: {
+						code: "read_only",
+						message: "Synthetic fixture API is read-only.",
+					},
+				},
+				405,
+			);
+		if (url.pathname === "/health")
+			return json({ status: "fixture", synthetic: true });
+		if (url.pathname === "/api/benchmarks")
+			return json({ benchmarks: BENCHMARKS });
+		if (url.pathname === "/api/challenges") return json({ challenges: [] });
+		const benchmarkMatch = /^\/api\/benchmarks\/([^/]+)(\/submissions)?$/.exec(
+			url.pathname,
+		);
+		if (benchmarkMatch) {
+			const ref = decodeURIComponent(benchmarkMatch[1]);
+			const benchmark = BENCHMARKS.find(
+				(entry) =>
+					entry.id === ref ||
+					entry.name === ref ||
+					(ref === "eigenlabs/catalyst" && entry.id === FIXTURE_BENCHMARK_ID),
+			);
+			if (!benchmark)
+				return json(
+					{
+						error: { code: "not_found", message: "Unknown fixture benchmark." },
+					},
+					404,
+				);
+			if (!benchmarkMatch[2]) return json({ benchmark });
+			const solver = url.searchParams.get("solver");
+			return json({
+				submissions: SUBMISSIONS.filter(
+					(submission) =>
+						submission.benchmarkId === benchmark.id &&
+						(!solver ||
+							submission.solverAccountId === solver ||
+							submission.solverUsername === solver),
+				),
+			});
+		}
+		if (url.pathname.startsWith("/api/submissions/")) {
+			const id = decodeURIComponent(
+				url.pathname.slice("/api/submissions/".length),
+			);
+			const submission = SUBMISSIONS.find((entry) => entry.id === id);
+			if (submission) return json({ submission });
+		}
+		const profileMatch = /^\/api\/solvers\/([^/]+)\/profile$/.exec(
+			url.pathname,
+		);
+		if (profileMatch) {
+			const username = decodeURIComponent(profileMatch[1]);
+			const owned = SUBMISSIONS.filter(
+				(submission) =>
+					submission.solverUsername === username &&
+					submission.status === "accepted" &&
+					submission.evaluation?.validity.valid === true,
+			);
+			if (!owned.length)
+				return json(
+					{ error: { code: "not_found", message: "Unknown fixture solver." } },
+					404,
+				);
+			return json({
+				solver: {
+					username,
+					avatarUrl: null,
+					profileUrl: `https://github.com/${encodeURIComponent(username)}`,
+				},
+				participations: BENCHMARKS.map((benchmark) => {
+					const contributions = owned.filter(
+						(submission) => submission.benchmarkId === benchmark.id,
+					);
+					return {
+						benchmark,
+						rank: username === "turing" ? 1 : username === "noether" ? 2 : 3,
+						solverCount: 3,
+						isChampion: username === "turing",
+						bestSubmission: contributions[1],
+						contributions: contributions.map((submission) => ({
+							submission,
+							previousScore: null,
+							previousMetrics: null,
+						})),
+						cumulativeGain: null,
+					};
+				}),
+			});
+		}
+		if (url.pathname === "/api/rewards/leaderboard")
+			return json({
+				window: {
+					kind: "week",
+					start: "2026-06-15T00:00:00.000Z",
+					end: "2026-06-22T00:00:00.000Z",
+				},
+				leaderboard: [],
+				entries: [],
+				rows: [],
+				totalEntries: "0",
+				totalSolvers: 0,
+			});
+		if (url.pathname.startsWith("/api/rewards/"))
+			return json({ wins: [], allocations: [] });
+		return json(
+			{
+				error: {
+					code: "not_found",
+					message: "This endpoint is not part of the Catalyst fixture.",
+				},
+			},
+			404,
+		);
+	},
+});
+console.log(`Synthetic Catalyst API: http://127.0.0.1:${server.port}`);
diff --git a/scripts/verify-catalyst-board.ts b/scripts/verify-catalyst-board.ts
new file mode 100644
index 00000000..07404b8a
--- /dev/null
+++ b/scripts/verify-catalyst-board.ts
@@ -0,0 +1,150 @@
+import assert from "node:assert/strict";
+import { chromium } from "playwright-core";
+
+const origin = process.env.CATALYST_PREVIEW_ORIGIN ?? "http://localhost:3000";
+const browser = await chromium.launch(
+	process.env.CHALLENGES_VERIFY_CHROME
+		? { executablePath: process.env.CHALLENGES_VERIFY_CHROME }
+		: { channel: "chrome" },
+);
+const errors: string[] = [];
+try {
+	const page = await browser.newPage({
+		viewport: { width: 1280, height: 900 },
+	});
+	page.on("pageerror", (error) => errors.push(error.message));
+	await page.goto(`${origin}/catalyst?as=turing`, { waitUntil: "networkidle" });
+	await page.getByText("Synthetic fixture data", { exact: false }).waitFor();
+	await page.waitForFunction(() =>
+		[...document.querySelectorAll<HTMLElement>("[data-hero-reveal]")].every(
+			(element) => Number(getComputedStyle(element).opacity) > 0.99,
+		),
+	);
+	await page.getByRole("button", { name: "How it works", exact: true }).click();
+	await page
+		.getByRole("dialog")
+		.getByText("Package and evaluate", { exact: true })
+		.waitFor();
+	await page
+		.getByRole("dialog")
+		.getByRole("button", { name: /close/i })
+		.click();
+	const budget = page.getByRole("spinbutton", {
+		name: "Viewing budget",
+		exact: true,
+	});
+	const firstHarness = () =>
+		page.locator("tbody tr").first().locator("th").innerText();
+	await budget.fill(".75");
+	await page.waitForFunction(() =>
+		document
+			.querySelector("tbody tr th")
+			?.textContent?.includes("Direct approach"),
+	);
+	assert.match(await firstHarness(), /Direct approach/);
+	await budget.fill("8");
+	await page.waitForFunction(() =>
+		document
+			.querySelector("tbody tr th")
+			?.textContent?.includes("Planning approach"),
+	);
+	assert.match(await firstHarness(), /Planning approach/);
+	assert.equal(await page.locator("tbody tr").count(), 3);
+	assert.equal(
+		await page.getByRole("img", { name: /Individual observed/ }).count(),
+		6,
+	);
+	await page.screenshot({
+		path: "/tmp/catalyst-yukon-desktop.png",
+		fullPage: true,
+	});
+	await page
+		.getByRole("combobox", { name: "Order by problem" })
+		.selectOption({ label: "Reconstruction error" });
+	assert.match(await firstHarness(), /Planning approach/);
+	await page.getByText("All submissions (20)", { exact: true }).click();
+	await page
+		.getByText("Harness violated the candidate-output contract.", {
+			exact: true,
+		})
+		.waitFor();
+	await page
+		.getByText("Worker timed out before producing a judgment.", { exact: true })
+		.waitFor();
+	await budget.fill(".1");
+	assert.equal(
+		await page.getByRole("img", { name: /Individual observed/ }).count(),
+		0,
+	);
+	assert.match(
+		await page.locator("tbody").innerText(),
+		/No observation within budget/,
+	);
+	await budget.fill("");
+	await page
+		.getByRole("alert")
+		.filter({ hasText: "finite, nonnegative" })
+		.waitFor();
+	await budget.fill("8");
+	await page
+		.locator('[data-solver="turing"]')
+		.getByRole("button", { name: "Share", exact: true })
+		.click();
+	const preview = page.getByRole("img", { name: /contribution/i });
+	await preview.waitFor();
+	await page.waitForFunction(() =>
+		[...document.images].some(
+			(image) =>
+				image.src.includes("/portfolio/") &&
+				image.complete &&
+				image.naturalWidth > 0,
+		),
+	);
+	assert.match((await preview.getAttribute("src")) ?? "", /portfolio/);
+	await page.goto(`${origin}/solver/turing?as=turing`, {
+		waitUntil: "networkidle",
+	});
+	await page.getByRole("heading", { name: /Challenge portfolio/i }).waitFor();
+	assert.equal(
+		await page.getByRole("button", { name: "Share", exact: true }).count(),
+		2,
+	);
+	await page.getByRole("button", { name: "Share", exact: true }).nth(1).click();
+	await page.waitForFunction(() =>
+		[...document.images].some(
+			(image) =>
+				image.src.includes("/portfolio/") &&
+				image.complete &&
+				image.naturalWidth > 0,
+		),
+	);
+	assert.match(
+		(await page
+			.getByRole("img", { name: /contribution/i })
+			.getAttribute("src")) ?? "",
+		/ca7a1000-0000-4000-8000-000000000002/,
+	);
+	await page.setViewportSize({ width: 390, height: 844 });
+	await page.goto(`${origin}/catalyst?solver=turing&as=turing`, {
+		waitUntil: "networkidle",
+	});
+	await page.getByText("Synthetic fixture data", { exact: false }).waitFor();
+	await page.screenshot({
+		path: "/tmp/catalyst-yukon-mobile.png",
+		fullPage: true,
+	});
+	const dimensions = await page.evaluate(() => ({
+		viewport: innerWidth,
+		page: document.documentElement.scrollWidth,
+	}));
+	assert.ok(
+		dimensions.page <= dimensions.viewport + 1,
+		"The matrix must scroll inside its container on mobile.",
+	);
+	assert.deepEqual(errors, [], "No client errors or hydration failures.");
+	console.log(
+		"Catalyst browser checks passed: native metrics, budgets, curves, history, share previews, portfolio, mobile.",
+	);
+} finally {
+	await browser.close();
+}
