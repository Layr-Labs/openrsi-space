@@ -0,0 +1,30 @@
+import {
+  buildMetricFormatter,
+  directedDelta,
+  directedPercent,
+  NO_VALUE,
+  signed,
+  trimmed,
+  type BenchmarkDirection,
+  type MetricFormatter,
+} from "@/shared/lib/metric-formatter";
+
+// No percentage conversion: problem scores retain their original units.
+export function buildMetrics(direction: BenchmarkDirection): MetricFormatter {
+  return buildMetricFormatter({
+    direction,
+    unit: null,
+    score: (value) => (value == null || !Number.isFinite(value) ? NO_VALUE : trimmed(value, 4)),
+    diff(score, reference, boundDirection, baseline) {
+      const delta = directedDelta(score, reference, boundDirection) ?? 0;
+      const percent = directedPercent(score, reference, boundDirection, baseline);
+      return `${signed(delta)}${trimmed(delta, 4)}${percent === null ? "" : ` (${signed(percent)}${percent.toFixed(2)}%)`}`;
+    },
+    gain: (gain) => `${signed(gain.absolute)}${trimmed(gain.absolute, 4)}`,
+    scoreDelta: (value) => (Number.isFinite(value) ? `${signed(value)}${trimmed(value, 4)}` : ""),
+    animated: (value) => (Number.isFinite(value) ? trimmed(value, 4) : NO_VALUE),
+    compact: (value) => (Number.isFinite(value) ? trimmed(value, 3) : NO_VALUE),
+  });
+}
+
+export const metrics = buildMetrics("+");
diff --git a/apps/challenges-ui/challenges/catalyst/lib/metrics.test.ts b/apps/challenges-ui/challenges/catalyst/lib/metrics.test.ts
