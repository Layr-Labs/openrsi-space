+++ b/apps/challenges-ui/challenges/catalyst/components/leaderboard.tsx
@@ -0,0 +1,393 @@
+"use client";
+import { useEffect, useState } from "react";
+import Link from "next/link";
+import { SECTION_CONFIG } from "@/challenges/catalyst";
+import { buildMetrics } from "@/challenges/catalyst/lib/metric-formatter";
+import {
+  buildMatrix,
+  comparisonKey,
+  measuredAttempts,
+  problemKey,
+  readMeasurement,
+  type Cell,
+  type Problem,
+} from "@/challenges/catalyst/lib/metrics";
+import { LocalTime } from "@/shared/components/local-time";
+import { solverProfileHref } from "@/shared/lib/solver-profile-href";
+import { contributionShareLinks } from "@/shared/lib/contribution-share";
+import type { PublicBenchmark, PublicSubmission } from "@/shared/lib/yukon-api-client";
+import { ShareContributionButton } from "@/shared/sections/share-contribution-button";
+
+export function Leaderboard({
+  benchmark,
+  submissions,
+  viewerUsername,
+}: {
+  benchmark: PublicBenchmark;
+  submissions: PublicSubmission[];
+  viewerUsername?: string | null;
+}) {
+  const [budget, setBudget] = useState("1");
+  const [selectedComparison, setComparison] = useState("");
+  const [selectedProblem, setProblem] = useState("");
+  const attempts = measuredAttempts(submissions);
+  const groups = [...new Map(attempts.map(({ measurement }) => [comparisonKey(measurement), measurement])).entries()];
+  const comparison = groups.some(([key]) => key === selectedComparison) ? selectedComparison : (groups[0]?.[0] ?? "");
+  const limit = budget.trim() === "" ? Number.NaN : Number(budget);
+  const validBudget = Number.isFinite(limit) && limit >= 0;
+  const { rows, problems } = buildMatrix(submissions, limit, comparison);
+  const sortProblem = problems.find((problem) => problemKey(problem) === selectedProblem) ?? problems[0];
+  if (sortProblem)
+    rows.sort((a, b) => {
+      const left = a.cells.get(problemKey(sortProblem));
+      const right = b.cells.get(problemKey(sortProblem));
+      if (left?.score == null) return right?.score == null ? a.key.localeCompare(b.key) : 1;
+      if (right?.score == null) return -1;
+      return (
+        Number(right.frontier) - Number(left.frontier) ||
+        (sortProblem.metric.direction === "+" ? right.score - left.score : left.score - right.score) ||
+        left.cost! - right.cost! ||
+        a.key.localeCompare(b.key)
+      );
+    });
+  const synthetic = attempts.some(({ measurement }) => measurement.evidence === "fixture");
+
+  // URL synchronization is an effect; all server data comes from React Query hooks.
+  const rowsIdentity = rows.map((row) => row.key).join("|");
+  useEffect(() => {
+    if (rowsIdentity.length === 0) return;
+    const username = new URLSearchParams(window.location.search).get("solver")?.toLowerCase();
+    if (!username) return;
+    const row = [...document.querySelectorAll<HTMLElement>("[data-solver]")].find(
+      (element) => element.dataset.solver === username,
+    );
+    row?.scrollIntoView({ behavior: "smooth", block: "center" });
+  }, [rowsIdentity]);
+
+  if (benchmark.mode !== "pareto")
+    return (
+      <p role="alert" className="text-sm text-bad">
+        Catalyst requires a Pareto benchmark. This benchmark is not compatible.
+      </p>
+    );
+  return (
+    <section aria-label="Harness performance and cost" className="grid min-w-0 gap-4">
+      <div>
+        <h2 className="font-display text-xl text-ink">Harness × problem</h2>
+        <p className="mt-2 text-xs leading-relaxed text-ink-dim">
+          Frontier first for the selected problem. Cells summarize independent attempts at the viewing budget; no scores
+          are interpolated.
+        </p>
+      </div>
+      {synthetic && (
+        <p role="status" className="rounded-lg border border-line bg-well p-3 text-sm text-ink">
+          Synthetic fixture data · these are not official evaluations.
+        </p>
+      )}
+      <div className="flex flex-wrap items-end gap-4">
+        <label className="grid gap-1 text-xs text-ink-dim">
+          Viewing budget · normalized model USD
+          <input
+            aria-label="Viewing budget"
+            type="number"
+            min="0"
+            step="any"
+            value={budget}
+            onChange={(event) => setBudget(event.target.value)}
+            aria-invalid={!validBudget}
+            className="w-40 rounded-md border border-line bg-bg px-3 py-2 font-mono text-sm text-ink"
+          />
+        </label>
+        {groups.length > 0 && (
+          <label className="grid min-w-0 max-w-full gap-1 text-xs text-ink-dim">
+            Model and execution conditions
+            <select
+              aria-label="Model and execution conditions"
+              value={comparison}
+              onChange={(event) => setComparison(event.target.value)}
+              className="max-w-full rounded-md border border-line bg-bg px-3 py-2 text-sm text-ink"
+            >
+              {groups.map(([key, measurement]) => (
+                <option key={key} value={key}>
+                  {measurement.model} · {measurement.conditions} · {measurement.evidence}
+                </option>
+              ))}
+            </select>
+          </label>
+        )}
+        {problems.length > 1 && (
+          <label className="grid gap-1 text-xs text-ink-dim">
+            Order by problem
+            <select
+              aria-label="Order by problem"
+              value={sortProblem ? problemKey(sortProblem) : ""}
+              onChange={(event) => setProblem(event.target.value)}
+              className="rounded-md border border-line bg-bg px-3 py-2 text-sm text-ink"
+            >
+              {problems.map((problem) => (
+                <option key={problemKey(problem)} value={problemKey(problem)}>
+                  {problem.title}
+                </option>
+              ))}
+            </select>
+          </label>
+        )}
+      </div>
+      {!validBudget ? (
+        <p role="alert" className="text-sm text-bad">
+          Enter a finite, nonnegative viewing budget.
+        </p>
+      ) : rows.length === 0 ? (
+        <p className="py-8 text-sm text-ink-dim">
+          No accepted, valid measurements are available yet. Submitting source alone does not produce a score.
+        </p>
+      ) : (
+        <div className="overflow-x-auto rounded-lg border border-line">
+          <table className="w-full text-left text-sm">
+            <caption className="sr-only">
+              Harness performance by exact problem version at normalized model budget {limit}
+            </caption>
+            <thead className="bg-well text-xs text-ink-dim">
+              <tr>
+                <th scope="col" className="min-w-48 p-4">
+                  Harness source version
+                </th>
+                {problems.map((problem) => (
+                  <th scope="col" key={problemKey(problem)} className="min-w-56 p-4">
+                    {problem.title}
+                    <span className="mt-1 block font-normal">
+                      {problem.metric.name}
+                      {problem.metric.unit ? ` (${problem.metric.unit})` : ""} ·{" "}
+                      {problem.metric.direction === "+" ? "higher" : "lower"} is better
+                    </span>
+                    <span className="mt-1 block font-mono font-normal">{problem.version.slice(0, 8)}</span>
+                  </th>
+                ))}
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((row, rank) => (
+                <tr
+                  key={row.key}
+                  className="border-t border-line"
+                  data-solver={row.submission.solverUsername?.toLowerCase()}
+                >
+                  <th scope="row" className="p-4 align-top font-normal">
+                    <p className="font-medium text-ink">{row.measurement.harness.title}</p>
+                    <p className="mt-1 font-mono text-xs text-ink-faint">
+                      {row.measurement.harness.version.slice(0, 12)}
+                    </p>
+                    {row.submission.solverUsername && (
+                      <Link
+                        className="mt-2 block text-xs text-accent-strong underline underline-offset-2"
+                        href={solverProfileHref(row.submission.solverUsername, {
+                          challenge: "catalyst",
+                          benchmark: row.submission.benchmarkId,
+                        })}
+                      >
+                        {row.submission.solverUsername}
+                      </Link>
+                    )}
+                    <p className="mt-2 text-xs text-ink-faint">
+                      <LocalTime at={row.submission.createdAt} />
+                    </p>
+                    {viewerUsername?.toLowerCase() === row.submission.solverUsername?.toLowerCase() &&
+                      row.submission.solverUsername && (
+                        <div className="mt-3">
+                          <ShareContributionButton
+                            routePrefix="/catalyst"
+                            slug="catalyst"
+                            variant="surface"
+                            modal={SECTION_CONFIG.modal}
+                            facts={{
+                              username: row.submission.solverUsername,
+                              challengeName: "Catalyst",
+                              rank: rank + 1,
+                              solverCount: rows.length,
+                              promotedCount: 0,
+                              bestScore: "measured performance versus cost",
+                              gain: "—",
+                              isChampion: false,
+                            }}
+                            shareText={(facts) =>
+                              `Explore ${facts.username}'s Catalyst harness measurements and cost curves.`
+                            }
+                            {...contributionShareLinks("/catalyst", {
+                              username: row.submission.solverUsername,
+                              benchmarkId: row.submission.benchmarkId,
+                              submissionId: row.submission.id,
+                              view: "pareto",
+                            })}
+                          />
+                        </div>
+                      )}
+                  </th>
+                  {problems.map((problem) => (
+                    <td key={problemKey(problem)} className="p-4 align-top">
+                      <MeasurementCell
+                        cell={row.cells.get(problemKey(problem))}
+                        problem={problem}
+                        budget={limit}
+                        scores={rows.flatMap(
+                          (item) =>
+                            item.cells
+                              .get(problemKey(problem))
+                              ?.attempts.flatMap(({ measurement }) =>
+                                measurement.observations
+                                  .filter((point) => point.cost <= limit)
+                                  .map((point) => point.score),
+                              ) ?? [],
+                        )}
+                      />
+                    </td>
+                  ))}
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+      <p className="text-xs leading-relaxed text-ink-faint">
+        Score and cost are separate medians of each attempt&apos;s best observation within budget. The frontier
+        describes these summaries. Recorded curves remain individual attempts; normalized model USD is not necessarily a
+        subscription charge.
+      </p>
+      <details className="rounded-lg border border-line p-4">
+        <summary className="cursor-pointer text-sm text-ink">All submissions ({submissions.length})</summary>
+        <ul className="mt-3 grid gap-3">
+          {submissions.map((submission) => {
+            const measurement = readMeasurement(submission.officialMetrics);
+            return (
+              <li key={submission.id} className="text-xs text-ink-dim">
+                <span className="font-mono text-ink">{submission.id.slice(0, 12)}</span> ·{" "}
+                {submission.solverUsername ?? "Anonymous"} · {submission.status}
+                {submission.evaluation
+                  ? ` · ${submission.evaluation.validity.valid ? "valid" : "invalid"}`
+                  : " · no completed judgment"}
+                {measurement ? ` · ${measurement.harness.title} · ${measurement.problem.title}` : ""}
+                <span className="ml-2">
+                  <LocalTime at={submission.createdAt} />
+                </span>
+                {(submission.evaluation?.validity.reason ?? submission.rejectionReason) && (
+                  <p className="mt-1">{submission.evaluation?.validity.reason ?? submission.rejectionReason}</p>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      </details>
+    </section>
+  );
+}
+
+function MeasurementCell({
+  cell,
+  problem,
+  budget,
+  scores,
+}: {
+  cell?: Cell;
+  problem: Problem;
+  budget: number;
+  scores: number[];
+}) {
+  if (cell === undefined) return <span className="text-xs text-ink-faint">Unmeasured</span>;
+  if (cell.score === null)
+    return <span className="text-xs text-ink-faint">No observation within budget · {cell.recorded} recorded</span>;
+  return (
+    <div className="grid gap-2">
+      <p className="font-mono text-base text-ink">
+        {buildMetrics(problem.metric.direction).score(cell.score)}
+        {problem.metric.unit ? ` ${problem.metric.unit}` : ""}{" "}
+        <span className="text-xs text-ink-dim">at ${cell.cost!.toFixed(3)}</span>
+      </p>
+      <p className="text-xs text-ink-dim">
+        {cell.eligible}/{cell.recorded} attempts within budget{cell.frontier ? " · Pareto frontier" : ""}
+      </p>
+      <ObservedCurves cell={cell} problem={problem} budget={budget} scores={scores} />
+      <details className="text-xs text-ink-dim">
+        <summary className="cursor-pointer text-accent-strong">Inspect observed curves</summary>
+        {cell.attempts.map(({ measurement }) => (
+          <div key={measurement.evaluationId} className="mt-3">
+            <p className="font-mono">{measurement.evaluationId}</p>
+            <p className="mt-1">Image {measurement.imageDigest.slice(0, 19)}…</p>
+            <ol className="mt-2 grid gap-1 font-mono">
+              {measurement.observations
+                .filter((point) => point.cost <= budget)
+                .map((point, index) => (
+                  <li key={`${point.cost}-${index}`}>
+                    ${point.cost.toFixed(3)} → {point.score}
+                  </li>
+                ))}
+            </ol>
+          </div>
+        ))}
+      </details>
+    </div>
+  );
+}
+
+function ObservedCurves({
+  cell,
+  problem,
+  budget,
+  scores,
+}: {
+  cell: Cell;
+  problem: Problem;
+  budget: number;
+  scores: number[];
+}) {
+  let low = Math.min(...scores);
+  let high = Math.max(...scores);
+  if (low === high) {
+    low -= 0.5;
+    high += 0.5;
+  }
+  const x = (cost: number) => 30 + (166 * cost) / (budget || 1);
+  const y = (score: number) => 64 - (52 * (score - low)) / (high - low);
+  const traces = cell.attempts.map(({ measurement }) => {
+    const points = measurement.observations.filter((point) => point.cost <= budget);
+    let best = points[0]?.score ?? 0;
+    const path = points
+      .map((point, index) => {
+        best = problem.metric.direction === "+" ? Math.max(best, point.score) : Math.min(best, point.score);
+        return index === 0 ? `M${x(point.cost)},${y(best)}` : `H${x(point.cost)}V${y(best)}`;
+      })
+      .join(" ");
+    return { id: measurement.evaluationId, path, points };
+  });
+  return (
+    <svg
+      viewBox="0 0 206 88"
+      role="img"
+      className="w-full max-w-56 text-accent-strong"
+      aria-label={`Individual observed ${problem.metric.name} curves; horizontal axis normalized model USD from zero to ${budget}. Curves stop at the last observation.`}
+    >
+      <title>Individual best-observed trajectories, without interpolation or extrapolation</title>
+      <path d="M30,8V66H198" fill="none" stroke="currentColor" opacity=".2" />
+      {traces.map((trace) => (
+        <g key={trace.id}>
+          <path d={trace.path} fill="none" stroke="currentColor" strokeWidth="1.5" opacity=".65" />
+          {trace.points.map((point, index) => (
+            <circle key={`${point.cost}-${index}`} cx={x(point.cost)} cy={y(point.score)} r="1.8" fill="currentColor" />
+          ))}
+        </g>
+      ))}
+      <g fill="currentColor" fontSize="8" fontFamily="monospace">
+        <text x="27" y="12" textAnchor="end">
+          {buildMetrics("+").compact(high)}
+        </text>
+        <text x="27" y="65" textAnchor="end">
+          {buildMetrics("+").compact(low)}
+        </text>
+        <text x="30" y="80">
+          $0
+        </text>
+        <text x="198" y="80" textAnchor="end">
+          ${budget}
+        </text>
+      </g>
+    </svg>
+  );
+}
