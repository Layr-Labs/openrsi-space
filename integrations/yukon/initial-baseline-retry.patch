+++ b/tests/unit/api-client-baseline-retry.test.ts
@@ -0,0 +1,19 @@
+import { expect, test } from "bun:test";
+import { YukonApiClient } from "../../packages/api-client/src/index.ts";
+
+test("baseline retry authenticates and binds the request to the observed failed job", async () => {
+  const previous = globalThis.fetch;
+  globalThis.fetch = (async (url: string | URL | Request, init?: RequestInit) => {
+    expect(String(url)).toBe("https://api.example.test/api/benchmarks/owner%2Fchallenge/baseline-retry");
+    expect(init?.method).toBe("POST");
+    expect(new Headers(init?.headers).get("authorization")).toBe("Bearer owner-token");
+    expect(JSON.parse(String(init?.body))).toEqual({ expectedJobId: "failed-job" });
+    return Response.json({ benchmark: { id: "same-benchmark" }, job: { id: "new-job" } }, { status: 202 });
+  }) as typeof fetch;
+  try {
+    const result = await new YukonApiClient({ baseUrl: "https://api.example.test", token: "owner-token" })
+      .retryBenchmarkBaseline("owner/challenge", "failed-job");
+    expect(result.benchmark.id).toBe("same-benchmark");
+    expect(result.job.id).toBe("new-job");
+  } finally { globalThis.fetch = previous; }
+});
