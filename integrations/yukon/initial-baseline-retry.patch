diff --git a/tests/integration/baseline-retry.test.ts b/tests/integration/baseline-retry.test.ts
new file mode 100644
index 00000000..4bc2a984
--- /dev/null
+++ b/tests/integration/baseline-retry.test.ts
@@ -0,0 +1,175 @@
+import { describe, expect, test } from "bun:test";
+import { cp, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { sql } from "drizzle-orm";
+import { createAccount, withTestApi, type TestApiContext } from "../helpers/api.ts";
+import type { Benchmark, Job } from "../../src/db/schema/index.ts";
+
+const pgTest = process.env.TEST_DATABASE_URL ? test : test.skip;
+type Attempt = { benchmark: Benchmark; job: Job };
+
+async function withFailedImport(mode: "scalar" | "pareto",
+  run: (ctx: TestApiContext & { sourceUrl: string; first: Attempt; token: string; accountId: string }) => Promise<void>) {
+  const root = await mkdtemp(path.join(os.tmpdir(), "yukon-baseline-retry-"));
+  try {
+    const sourceUrl = path.join(root, "repo");
+    await cp(mode === "pareto" ? "benchmarks/pareto" : "benchmarks/scoretxt", sourceUrl, { recursive: true });
+    await withTestApi(async ctx => {
+      const setter = await createAccount(ctx.app, "setter@example.com");
+      const manifestFile = path.join(sourceUrl, "benchmark.json");
+      const manifest = JSON.parse(await readFile(manifestFile, "utf8"));
+      await writeFile(manifestFile, JSON.stringify({ ...manifest, benchmarkCommand: ["false"] }));
+      const response = await ctx.app.request("/api/benchmarks", {
+        method: "POST", headers: { Authorization: `Bearer ${setter.token}`, "content-type": "application/json" },
+        body: JSON.stringify({ sourceUrl }),
+      });
+      expect(response.status).toBe(202);
+      const first = await response.json() as Attempt;
+      await ctx.worker.drain();
+      expect((await ctx.store.getBenchmark(first.benchmark.id))?.status).toBe("failed");
+      await writeFile(manifestFile, JSON.stringify(manifest));
+      await run({ ...ctx, sourceUrl, first, token: setter.token, accountId: setter.accountId });
+    });
+  } finally { await rm(root, { recursive: true, force: true }); }
+}
+
+function retry(ctx: { app: TestApiContext["app"]; token: string; first: Attempt }, expectedJobId: string, extra = {}) {
+  return ctx.app.request(`/api/benchmarks/${ctx.first.benchmark.id}/baseline-retry`, {
+    method: "POST", headers: { Authorization: `Bearer ${ctx.token}`, "content-type": "application/json" },
+    body: JSON.stringify({ expectedJobId, ...extra }),
+  });
+}
+
+describe("standalone initial baseline retry", () => {
+  for (const mode of ["scalar", "pareto"] as const) {
+    pgTest(`${mode}: failed retries retain UUID, history and owner metadata; corrected source becomes ready`, async () => {
+      await withFailedImport(mode, async ctx => {
+        const { store, worker, first, sourceUrl, app, token, repositoryGateway } = ctx;
+        const before = (await store.getBenchmark(first.benchmark.id))!;
+        const originalJob = await store.getJob(first.job.id);
+        const resolve = repositoryGateway.resolve.bind(repositoryGateway);
+        let revision = "b".repeat(40);
+        repositoryGateway.resolve = async input => ({ ...await resolve(input), sourceRef: revision });
+        await store.executeForTests(sql`UPDATE benchmarks SET description = 'Author metadata', category = 'research',
+          research_discussions_enabled = true WHERE id = ${before.id}::uuid`);
+        const manifestFile = path.join(sourceUrl, "benchmark.json");
+        const fixed = JSON.parse(await readFile(manifestFile, "utf8"));
+        await writeFile(manifestFile, JSON.stringify({ ...fixed, benchmarkCommand: ["false"] }));
+        const response = await retry(ctx, first.job.id);
+        expect(response.status).toBe(202);
+        const second = await response.json() as Attempt;
+        expect(second.benchmark).toMatchObject({ id: before.id, name: before.name, setterAccountId: before.setterAccountId,
+          status: "validating", sourceRef: revision, description: "Author metadata", category: "research", researchDiscussionsEnabled: true });
+        expect(second.job.id).not.toBe(first.job.id);
+        expect(second.job.input).toMatchObject({ sourceRef: revision, retryOfJobId: first.job.id });
+        expect((await retry(ctx, first.job.id)).status).toBe(409);
+        await worker.drain();
+        expect((await store.getBenchmark(before.id))?.status).toBe("failed");
+        expect((await retry(ctx, first.job.id)).status).toBe(409); // delayed duplicate cannot retry the new failure
+        const failedSecond = await store.getJob(second.job.id);
+        await writeFile(manifestFile, JSON.stringify(fixed));
+        revision = "c".repeat(40);
+        const thirdResponse = await retry(ctx, second.job.id);
+        expect(thirdResponse.status).toBe(202);
+        const third = await thirdResponse.json() as Attempt;
+        expect(third.job.input).toMatchObject({ sourceRef: revision, retryOfJobId: second.job.id });
+        await worker.drain();
+        const ready = (await store.getBenchmark(before.id))!;
+        expect(ready).toMatchObject({ id: before.id, name: before.name, status: "ready", sourceRef: revision });
+        if (mode === "pareto") expect(ready.activeEvaluationId).not.toBeNull();
+        expect(await store.getJob(first.job.id)).toEqual(originalJob);
+        expect(await store.getJob(second.job.id)).toEqual(failedSecond);
+        expect(await store.listJobsForBenchmark(before.id)).toHaveLength(3);
+        expect((await retry(ctx, third.job.id)).status).toBe(409);
+        const opened = await app.request(`/api/benchmarks/${before.id}/open`, {
+          method: "POST", headers: { Authorization: `Bearer ${token}`, "content-type": "application/json" }, body: "{}",
+        });
+        expect(opened.status).toBe(200);
+      });
+    });
+  }
+
+  pgTest("concurrent retries queue one job and do not permit stale worker results", async () => {
+    await withFailedImport("pareto", async ctx => {
+      const original = (await ctx.store.getJob(ctx.first.job.id))!;
+      const responses = await Promise.all([retry(ctx, ctx.first.job.id), retry(ctx, ctx.first.job.id)]);
+      expect(responses.map(r => r.status).sort()).toEqual([202, 409]);
+      expect(await ctx.store.listJobsForBenchmark(ctx.first.benchmark.id)).toHaveLength(2);
+      expect(await ctx.store.finishBaselineJob({ jobId: ctx.first.job.id, error: "late failure" })).toEqual(original);
+      expect((await ctx.store.getBenchmark(ctx.first.benchmark.id))?.status).toBe("validating");
+      // Even a stale process holding the old job as running cannot publish over a new attempt.
+      await ctx.store.executeForTests(sql`UPDATE jobs SET status = 'running' WHERE id = ${ctx.first.job.id}::uuid`);
+      expect((await ctx.store.finishBaselineJob({ jobId: ctx.first.job.id, error: "stale process" })).error)
+        .toBe("stale Pareto baseline result discarded");
+      await ctx.worker.drain();
+      expect((await ctx.store.getBenchmark(ctx.first.benchmark.id))?.status).toBe("ready");
+    });
+  });
+
+  pgTest("requires owner/import permission and rejects supplied source or scores", async () => {
+    await withFailedImport("pareto", async ctx => {
+      const stranger = await createAccount(ctx.app, "other@example.com");
+      process.env.YUKON_BENCHMARK_IMPORTER_EMAILS = "setter@example.com,other@example.com";
+      expect((await retry({ ...ctx, token: stranger.token }, ctx.first.job.id)).status).toBe(403);
+      expect((await retry({ ...ctx, token: "" }, ctx.first.job.id)).status).toBe(401);
+      process.env.YUKON_BENCHMARK_IMPORTER_EMAILS = "other@example.com";
+      expect((await retry(ctx, ctx.first.job.id)).status).toBe(403);
+      process.env.YUKON_BENCHMARK_IMPORTER_EMAILS = "setter@example.com";
+      for (const extra of [{ sourceRef: "attacker" }, { sourceUrl: "https://attacker.invalid" }, { scores: [1, 2] }]) {
+        expect((await retry(ctx, ctx.first.job.id, extra)).status).toBe(400);
+      }
+      expect(await ctx.store.listJobsForBenchmark(ctx.first.benchmark.id)).toHaveLength(1);
+    });
+  });
+
+  pgTest("rechecks owner and source under the store lock and refuses reorg failures", async () => {
+    await withFailedImport("pareto", async ctx => {
+      const { store, first, repositoryGateway, sourceUrl } = ctx;
+      const source = await repositoryGateway.resolve({ sourceUrl, sourceBranch: null, rootDir: null });
+      const input = { benchmarkId: first.benchmark.id, accountId: ctx.accountId, expectedJobId: first.job.id,
+        manifest: source.manifest, sourceUrl, sourceBranch: null, rootDir: null, sourceRef: "b".repeat(40) };
+      const stranger = await createAccount(ctx.app, "other@example.com");
+      await expect(store.retryBenchmarkBaseline({ ...input, accountId: stranger.accountId })).rejects.toThrow("owner");
+      for (const edit of [{ sourceUrl: "different" }, { sourceBranch: "different" }, { rootDir: "different" }]) {
+        await expect(store.retryBenchmarkBaseline({ ...input, ...edit })).rejects.toThrow("saved repository");
+      }
+      await store.executeForTests(sql`UPDATE jobs SET input = input || '{"reorgId":"old-reorg"}'::jsonb
+        WHERE id = ${first.job.id}::uuid`);
+      expect((await retry(ctx, first.job.id)).status).toBe(409);
+      expect(await store.listJobsForBenchmark(first.benchmark.id)).toHaveLength(1);
+    });
+  });
+
+  pgTest("rejects incompatible contracts, active work, prior activity and archived imports without changes", async () => {
+    await withFailedImport("pareto", async ctx => {
+      const { store, first, sourceUrl } = ctx;
+      const manifestFile = path.join(sourceUrl, "benchmark.json");
+      const manifest = JSON.parse(await readFile(manifestFile, "utf8"));
+      const before = await store.getBenchmark(first.benchmark.id);
+      for (const edit of [
+        { editablePaths: ["different"] },
+        { objectives: [{ name: "different", direction: "-" }] },
+        { mode: "scalar", direction: "-", objectives: undefined },
+      ]) {
+        await writeFile(manifestFile, JSON.stringify({ ...manifest, ...edit }));
+        expect((await retry(ctx, first.job.id)).status).toBe(409);
+        expect(await store.getBenchmark(first.benchmark.id)).toEqual(before);
+      }
+      await writeFile(manifestFile, JSON.stringify(manifest));
+      const active = await store.createJob({ kind: "benchmark_baseline", accountId: ctx.accountId,
+        benchmarkId: first.benchmark.id, input: { sourceRef: "local" } });
+      expect((await retry(ctx, active.id)).status).toBe(409);
+      await store.failJob({ jobId: active.id, error: "test" });
+      await store.executeForTests(sql`UPDATE benchmarks SET opened_at = now() WHERE id = ${first.benchmark.id}::uuid`);
+      expect((await retry(ctx, active.id)).status).toBe(409);
+      await store.executeForTests(sql`UPDATE benchmarks SET opened_at = NULL WHERE id = ${first.benchmark.id}::uuid`);
+      await store.executeForTests(sql`INSERT INTO submissions (benchmark_id, solver_account_id, status, candidate_archive_ref, deleted_at)
+        VALUES (${first.benchmark.id}::uuid, ${ctx.accountId}::uuid, 'failed', 'archived-test', now())`);
+      expect((await retry(ctx, active.id)).status).toBe(409); // archived history still counts
+      await store.archiveBenchmark(first.benchmark.id);
+      expect((await retry(ctx, active.id)).status).toBe(404);
+      expect(await store.listJobsForBenchmark(first.benchmark.id)).toHaveLength(2);
+    });
+  });
+});
