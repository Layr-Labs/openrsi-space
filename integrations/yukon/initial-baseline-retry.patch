+        throw new StoreInvariantError("retry cannot change mode, objectives, score direction or editable paths");
+      }
+      const [row] = await tx.update(benchmarks).set({
+        ...activeManifestFields(manifest),
+        // Keep author metadata, access, rewards and identity independent of source refresh.
+        description: current.description, category: current.category,
+        sourceRef: input.sourceRef, status: "validating",
