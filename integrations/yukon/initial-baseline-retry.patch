+  async retryBenchmarkBaseline(input: RetryBenchmarkBaselineInput): Promise<{ benchmark: Benchmark; job: Job }> {
+    return await this.db.transaction(async (tx) => {
+      const current = await loadBenchmarkForUpdate(tx, input.benchmarkId);
+      if (current.deletedAt !== null) throw new StoreNotFoundError("benchmark", current.id);
+      if (current.setterAccountId !== input.accountId) throw new StoreForbiddenError("only the benchmark owner can retry its baseline");
+      if (current.challengeId !== null) throw new StoreInvariantError("use challenge reconciliation to retry failed tracks");
+      if (current.status !== "failed") throw new StoreInvariantError("only failed initial validations can be retried");
+      if (current.sourceUrl !== input.sourceUrl || current.sourceBranch !== input.sourceBranch || current.rootDir !== input.rootDir) {
+        throw new StoreInvariantError("retry must use the saved repository, branch and root directory");
+      }
+      const [latest] = await tx.select().from(jobs).where(and(
+        eq(jobs.benchmarkId, current.id), eq(jobs.kind, "benchmark_baseline"),
+      )).orderBy(desc(jobs.createdAt), desc(jobs.id)).limit(1);
+      if (!latest || latest.id !== input.expectedJobId) throw new StoreInvariantError("baseline attempt changed; inspect the latest job before retrying");
+      const [active] = await tx.select({ id: jobs.id }).from(jobs).where(and(
